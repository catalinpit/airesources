---
import '../styles/global.css';
import Layout from '../layouts/layout.astro';
import SectionLabel from '../components/ui/Section-Label.astro';
import SearchInput from '../components/ui/Search-Input.astro';
import ResourceList from '../components/ui/Resource-List.astro';
import FilterBar from '../components/ui/FilterBar.astro';
import SponsoredProducts from '../components/ui/Sponsored-Products.astro';
import StackAvatar from '../components/ui/Stack-Avatar.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION } from '../lib/site';
import { pluralize, resolveStacks } from '../lib/stacks';

const allCategories = await getCollection('categories');
const allResources = await getCollection('resources');
const stacks = resolveStacks(await getCollection('stacks'), allResources, allCategories);
const MAX_STACK_AVATARS = 5;

const categoryTitles = new Map(
	allCategories.map(category => [category.data.categorySlug, category.data.title])
);

const allItems = allResources.map(resource => ({
	...resource.data,
	categoryTitle: categoryTitles.get(resource.data.categorySlug),
}));

const listedItems = allItems
	.filter(item => !item.sponsored || item.sponsored === "small")
	.sort((a, b) => a.name.localeCompare(b.name));

const categoryLinks = allCategories
	.map(category => ({
		title: category.data.title,
		href: `/category/${category.data.categorySlug}/`,
		count: listedItems.filter(item => item.categorySlug === category.data.categorySlug).length,
	}))
	.filter(category => category.count > 0)
	.sort((a, b) => b.count - a.count || a.title.localeCompare(b.title));

const MIN_PROMINENT_CATEGORY_SIZE = 3;
const prominentCategories = categoryLinks.filter(category => category.count >= MIN_PROMINENT_CATEGORY_SIZE);
const smallCategories = categoryLinks.filter(category => category.count < MIN_PROMINENT_CATEGORY_SIZE);

const chipClass = "inline-flex h-8 items-center gap-1.5 rounded-lg bg-black/[0.04] px-3 text-sm font-medium text-neutral-700 transition-colors hover:bg-black/[0.08] hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40";

---

<Layout description={SITE_DESCRIPTION}>
	<div class="relative isolate overflow-hidden bg-neutral-50 text-neutral-900">
		<div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[32rem] bg-[radial-gradient(60rem_22rem_at_50%_-6rem,rgba(99,102,241,0.14),transparent_70%)]"></div>

		<div class="mx-auto max-w-4xl px-3 pb-16 sm:px-6 pt-14 sm:pt-20 lg:px-8">
			<header class="mx-auto max-w-2xl text-center">
				<h1 class="text-3xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
					Vetted AI resources
				</h1>
				<p class="mt-4 text-[15px] leading-6 text-neutral-600 sm:text-lg sm:leading-8">
					{SITE_DESCRIPTION}
				</p>
				<SearchInput size="large" class="mt-8" />
			</header>

			<section class="mt-12">
				<SectionLabel label="Categories" class="mb-3" />
				<nav class="flex flex-wrap gap-2" aria-label="Categories">
					{prominentCategories.map((category) => (
						<a href={category.href} class={chipClass}>
							{category.title}
							<span class="text-xs text-neutral-600">{category.count}</span>
						</a>
					))}
					{smallCategories.map((category) => (
						<a href={category.href} class={chipClass} hidden data-small-category>
							{category.title}
							<span class="text-xs text-neutral-600">{category.count}</span>
						</a>
					))}
					{smallCategories.length > 0 && (
						<button
							type="button"
							id="show-small-categories"
							class="inline-flex h-8 items-center rounded-lg px-3 text-sm font-medium text-neutral-500 transition-colors hover:bg-black/[0.04] hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40"
						>
							+{smallCategories.length} more
						</button>
					)}
				</nav>
			</section>

			<section class="mt-12" aria-labelledby="stacks-heading">
				<SectionLabel label="Stacks" class="mb-3" />
				<div class="flex flex-col gap-4 rounded-xl border border-black/[0.06] bg-white p-5 shadow-[0_8px_30px_rgba(0,0,0,0.04)] sm:flex-row sm:items-center sm:justify-between">
					<div class="flex items-center gap-4">
						{stacks.length > 0 && (
							<div class="flex flex-shrink-0 -space-x-2">
								{stacks.slice(0, MAX_STACK_AVATARS).map((stack) => (
									<StackAvatar stack={stack} size="sm" class="ring-white" />
								))}
							</div>
						)}
						<div>
							<h2 id="stacks-heading" class="text-[15px] font-semibold leading-6 text-neutral-900">See what people actually use</h2>
							<p class="text-sm leading-5 text-neutral-500">
								{pluralize(stacks.length, 'developer has', 'developers have')} published their AI stack. Add yours in a few minutes.
							</p>
						</div>
					</div>
					<div class="flex flex-shrink-0 flex-wrap gap-2">
						<a href="/stack/" class={chipClass}>Browse stacks</a>
						<a href="/stack/new/" class="inline-flex h-8 items-center rounded-lg bg-indigo-600 px-3 text-sm font-medium text-white transition-colors hover:bg-indigo-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40">
							Create yours
						</a>
					</div>
				</div>
			</section>

			<SponsoredProducts items={allItems} class="mt-12" />

			<section id="catalog" class="mt-12 scroll-mt-20">
				<FilterBar title="All resources" showSearch={false} allResources={listedItems} />
				<ResourceList items={listedItems} showCategory />
			</section>
		</div>
	</div>
</Layout>

<script>
	const showSmallCategories = document.getElementById('show-small-categories');
	const smallCategories = document.querySelectorAll<HTMLElement>('[data-small-category]');

	showSmallCategories?.addEventListener('click', () => {
		smallCategories.forEach((category) => { category.hidden = false; });
		showSmallCategories.remove();
	});
</script>
