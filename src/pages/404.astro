---
import '../styles/global.css';
import Layout from '../layouts/layout.astro';
import Button from '../components/ui/Button.astro';
import PageShell from '../components/ui/Page-Shell.astro';
import LogoIcon from '../components/icons/LogoIcon.astro';
import { getCollection } from 'astro:content';

const description = 'The resource you are looking for is not in the AI Resources directory.';

const categories = await getCollection('categories');
const resources = await getCollection('resources');

const categoryLinks = categories
  .map(category => ({
    title: category.data.title,
    href: `/category/${category.data.categorySlug}/`,
    count: resources.filter(resource => resource.data.categorySlug === category.data.categorySlug).length,
  }))
  .filter(category => category.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 4);
---

<Layout description={description} pageTitle="Resource Not Found">
  <PageShell class="py-14 sm:py-18">
    <section>
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
        <div class="max-w-3xl">
          <div class="mb-5 inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
            <LogoIcon class="h-3.5 w-3.5" />
            Missing resource
          </div>

          <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-neutral-900 sm:text-5xl lg:text-6xl">
            Resource not found
          </h1>
          <p class="mt-5 max-w-2xl text-[15px] leading-6 text-neutral-600 sm:text-lg sm:leading-8">
            This resource may have moved, been removed, or never made it into the directory.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="/" class="h-10">Browse all resources</Button>
          </div>
        </div>

        {categoryLinks.length > 0 && (
          <aside class="pt-1 lg:border-l lg:border-black/[0.06] lg:pl-6">
            <p class="mb-3 font-mono text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">
              Popular sections
            </p>
            <div class="space-y-1">
              {categoryLinks.map(category => (
                <a
                  href={category.href}
                  class="group flex items-center justify-between gap-4 rounded-lg px-2 py-2 transition-colors hover:bg-black/[0.04]"
                >
                  <span class="truncate text-sm font-medium text-neutral-700 transition-colors group-hover:text-neutral-900">
                    {category.title}
                  </span>
                  <span class="rounded-md bg-black/[0.04] px-2 py-1 text-xs font-medium text-neutral-500">
                    {category.count}
                  </span>
                </a>
              ))}
            </div>
          </aside>
        )}
      </div>
    </section>
  </PageShell>
</Layout>
