---
import '../../styles/global.css';
import Layout from '../../layouts/layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CopyButton from '../../components/ui/Copy-Button.astro';
import PageShell from '../../components/ui/Page-Shell.astro';
import SectionLabel from '../../components/ui/Section-Label.astro';
import StackAvatar from '../../components/ui/Stack-Avatar.astro';
import StackTile from '../../components/ui/Stack-Tile.astro';
import HighlightIcon from '../../components/ui/Highlight-Icon.astro';
import GitHubIcon from '../../components/icons/GitHubIcon.astro';
import TwitterIcon from '../../components/icons/TwitterIcon.astro';
import { formatMonthYear, pluralize } from '../../lib/format';
import { resourcePath } from '../../lib/resources';
import { REPO_URL, SITE_URL } from '../../lib/site';
import { schemaOrgType, toJsonLd } from '../../lib/structured-data';
import { getStacks, stackDescription, stackPath, stackShareText } from '../../lib/stacks';
import type { StackSection } from '../../lib/stacks';

export async function getStaticPaths() {
  const stacks = await getStacks();
  return stacks.map((stack) => ({ params: { handle: stack.handle }, props: { stack } }));
}

const { stack } = Astro.props;
const { name, bio, links, updatedAt } = stack.data;

const siteUrl = Astro.site ?? SITE_URL;
const pageUrl = new URL(stackPath(stack.handle), siteUrl).href;
const pageTitle = `${name}'s AI stack`;
const description = stackDescription(stack);

const shareUrl = `https://x.com/intent/post?${new URLSearchParams({ text: stackShareText(stack), url: pageUrl })}`;
const editUrl = `${REPO_URL}/edit/main/src/content/stacks/${stack.handle}.json`;

const website = links?.website;
const github = links?.github ? { href: `https://github.com/${links.github}`, label: links.github } : undefined;
const x = links?.x ? { href: `https://x.com/${links.x}`, label: `@${links.x}` } : undefined;

const profileLinks = [
  ...(website ? [{ href: website, label: new URL(website).hostname.replace(/^www\./, ''), icon: 'globe' as const }] : []),
  ...(github ? [{ ...github, icon: 'github' as const }] : []),
  ...(x ? [{ ...x, icon: 'x' as const }] : []),
];

// Social profiles for schema.org `sameAs`; the website is the Person's `url`.
const sameAs = [github, x].flatMap((profile) => (profile ? [profile.href] : []));

const facts = [
  pluralize(stack.items.length, 'resource'),
  pluralize(stack.sections.length, 'category', 'categories'),
  updatedAt && `Updated ${formatMonthYear(updatedAt)}`,
].filter(Boolean).join(' · ');

// Sections sit two to a row. Ones with too many tiles for half a row lead and
// take the whole row; if an odd one is left over it takes the whole row too,
// so the grid has no hole.
const WIDE_SECTION_MIN_ITEMS = 5;
const isWide = (section: StackSection) => section.items.length >= WIDE_SECTION_MIN_ITEMS;
const orderedSections = [...stack.sections.filter(isWide), ...stack.sections.filter((section) => !isWide(section))];
const narrowCount = orderedSections.length - orderedSections.filter(isWide).length;
const spansBothColumns = (section: StackSection, index: number) =>
  isWide(section) || (narrowCount % 2 === 1 && index === orderedSections.length - 1);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: pageTitle,
  description,
  url: pageUrl,
  ...(updatedAt && { dateModified: updatedAt }),
  mainEntity: {
    '@type': 'Person',
    name,
    ...(bio && { description: bio }),
    ...(stack.avatarUrl && { image: stack.avatarUrl }),
    ...(website && { url: website }),
    ...(sameAs.length > 0 && { sameAs }),
  },
  hasPart: {
    '@type': 'ItemList',
    numberOfItems: stack.items.length,
    itemListElement: stack.items.map((resource, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': schemaOrgType(resource),
        name: resource.name,
        url: new URL(resourcePath(resource), siteUrl).href,
      },
    })),
  },
};

const breadcrumbs = [{ label: 'Resources', href: '/' }, { label: 'Stacks', href: '/stack/' }, { label: name }];
---

<Layout description={description} pageTitle={pageTitle}>
  <script is:inline type="application/ld+json" set:html={toJsonLd(structuredData)} />
  <PageShell>
    <Breadcrumbs class="mb-6" items={breadcrumbs} />

    <Card as="header" class="bg-[linear-gradient(180deg,rgba(99,102,241,0.07),rgba(255,255,255,0)_55%)] p-6 md:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <StackAvatar name={name} avatarUrl={stack.avatarUrl} size="xl" class="ring-4 ring-white shadow-[0_8px_24px_rgba(0,0,0,0.08)]" />
        <div class="min-w-0 flex-1">
          <SectionLabel label={facts} class="mb-2" />
          <h1 class="break-words text-2xl font-semibold tracking-tight text-neutral-900 sm:text-3xl md:text-4xl">
            {pageTitle}
          </h1>
          {bio && (
            <p class="mt-3 max-w-2xl text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-7">{bio}</p>
          )}
          {profileLinks.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {profileLinks.map((link) => (
                <li>
                  <Button variant="outline" href={link.href} class="h-8 gap-1.5 px-3">
                    {link.icon === 'github' && <GitHubIcon class="h-3.5 w-3.5 text-neutral-900" />}
                    {link.icon === 'x' && <TwitterIcon class="h-3.5 w-3.5 text-neutral-900" />}
                    {link.icon === 'globe' && <HighlightIcon name="globe" class="h-3.5 w-3.5 text-indigo-600" />}
                    {link.label}
                  </Button>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="flex flex-shrink-0 gap-2 sm:flex-col">
          <Button href={shareUrl} class="gap-2 px-4">
            <TwitterIcon class="h-3.5 w-3.5" />
            Share<span class="sr-only"> on X</span>
          </Button>
          <CopyButton text={pageUrl} label="Copy link" title="Copy the link to this stack" class="px-3" />
        </div>
      </div>
    </Card>

    <Card class="mt-6 overflow-hidden">
      {/* 1px gaps over a tinted background draw the dividers between cells. */}
      <div class="grid gap-px bg-black/[0.06] sm:grid-cols-2">
        {orderedSections.map((section, index) => {
          const headingId = `section-${section.category.categorySlug}`;
          return (
            <section class:list={["bg-white px-5 py-5", spansBothColumns(section, index) && "sm:col-span-2"]} aria-labelledby={headingId}>
              <div class="flex items-baseline justify-between gap-3">
                <h2 id={headingId} class="text-sm font-semibold text-neutral-900">{section.category.title}</h2>
                <a href={`/category/${section.category.categorySlug}/`} class="whitespace-nowrap text-xs text-neutral-500 transition-colors hover:text-indigo-600">
                  {pluralize(section.items.length, 'pick')}<span class="sr-only">; browse all {section.category.title.toLowerCase()}</span> →
                </a>
              </div>
              <ul class="-mx-1 mt-3 flex flex-wrap gap-y-1">
                {section.items.map((resource) => (
                  <li><StackTile resource={resource} /></li>
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    </Card>

    <section class="mt-14 rounded-xl border border-dashed border-black/[0.12] px-6 py-8 text-center">
      <h2 class="text-lg font-semibold text-neutral-900">What's in your stack?</h2>
      <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-neutral-600">
        Tick the tools, prompts, and skills you use and get a page like this one at
        <span class="whitespace-nowrap font-medium text-neutral-800">airesources.dev/stack/you</span>.
      </p>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
        <Button href="/stack/new/" class="h-10 px-5">Create your stack</Button>
        <Button variant="outline" href="/stack/" class="h-10">Browse stacks</Button>
      </div>
      <p class="mt-6 text-xs text-neutral-500">
        Is this your stack?
        <a href={editUrl} target="_blank" rel="noopener noreferrer" class="text-indigo-600 transition-colors hover:text-indigo-500">
          Update it on GitHub<span class="sr-only"> (opens in new tab)</span>
        </a>
      </p>
    </section>
  </PageShell>
</Layout>
