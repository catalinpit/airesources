---
import '../../styles/global.css';
import Layout from '../../layouts/layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import CopyButton from '../../components/ui/Copy-Button.astro';
import PageShell from '../../components/ui/Page-Shell.astro';
import SectionLabel from '../../components/ui/Section-Label.astro';
import StackPick from '../../components/ui/Stack-Pick.astro';
import ExternalLinkIcon from '../../components/icons/ExternalLinkIcon.astro';
import { getCollection } from 'astro:content';
import { groupByCategory } from '../../lib/resources';
import { REPO_URL } from '../../lib/site';
import { PROFILE_FIELDS } from '../../lib/stack-builder';
import { STACK_LIMITS } from '../../lib/stack-rules';
import { compareStackCategories, getStacks } from '../../lib/stacks';

const [resources, categories, stacks] = await Promise.all([
  getCollection('resources'),
  getCollection('categories'),
  getStacks(),
]);

const groups = groupByCategory(
  [...resources].sort((a, b) => a.data.name.localeCompare(b.data.name)),
  (resource) => resource.data.categorySlug,
  categories.map((category) => category.data),
).sort((a, b) => compareStackCategories(a.category, b.category));

const description =
  'Pick the AI tools, prompts, and skills you use and publish them as a shareable page at airesources.dev/stack/you.';

const inputClass = 'h-10 w-full rounded-lg bg-white px-3 text-sm text-neutral-900 placeholder-neutral-400 shadow-[0_1px_2px_rgba(0,0,0,0.04)] ring-1 ring-inset ring-black/[0.08] transition focus:outline-none focus:ring-2 focus:ring-indigo-500/50';
const labelClass = 'mb-1.5 block text-sm font-medium text-neutral-800';
const hintClass = 'mt-1.5 text-xs text-neutral-500';

const breadcrumbs = [{ label: 'Resources', href: '/' }, { label: 'Stacks', href: '/stack/' }, { label: 'Create' }];
---

<Layout description={description} pageTitle="Create your AI stack">
  <PageShell>
    <Breadcrumbs class="mb-6" items={breadcrumbs} />

    <header class="mb-8 max-w-2xl">
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">Create your AI stack</h1>
      <p class="mt-3 text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-7">
        Pick the tools you use, add a few words on why, and we prefill the file for your pull request. Your page goes live at
        <span class="whitespace-nowrap font-medium text-neutral-800">airesources.dev/stack/you</span> once it's merged.
      </p>
    </header>

    <form
      data-stack-builder
      data-repo-url={REPO_URL}
      data-taken-handles={stacks.map((stack) => stack.handle).join(',')}
      class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start"
      novalidate
    >
      <div class="space-y-8">
        <Card as="section" class="p-6" aria-labelledby="about-heading">
          <SectionLabel label="Step 1" class="mb-1" />
          <h2 id="about-heading" class="text-lg font-semibold text-neutral-900">About you</h2>

          <div class="mt-5 grid gap-5 sm:grid-cols-2">
            {PROFILE_FIELDS.map((field) => (
              <div class:list={{ 'sm:col-span-2': field.wide === true }}>
                <label for={`field-${field.key}`} class={labelClass}>
                  {field.label}
                  {field.key === 'handle' ? (
                    <span class="text-neutral-400"> (your URL)</span>
                  ) : (
                    !field.required && <span class="text-neutral-400"> (optional)</span>
                  )}
                </label>
                {field.key === 'handle' ? (
                  <div class="flex items-stretch">
                    <span class="inline-flex items-center rounded-l-lg bg-black/[0.04] px-3 font-mono text-xs text-neutral-500 ring-1 ring-inset ring-black/[0.08]">
                      airesources.dev/stack/
                    </span>
                    <input
                      id={`field-${field.key}`}
                      name={field.key}
                      type="text"
                      placeholder={field.placeholder}
                      maxlength={field.maxlength}
                      autocomplete="off"
                      autocapitalize="off"
                      spellcheck="false"
                      data-profile-field
                      class:list={[inputClass, 'rounded-l-none font-mono']}
                    />
                  </div>
                ) : (
                  <input
                    id={`field-${field.key}`}
                    name={field.key}
                    type={field.type ?? 'text'}
                    placeholder={field.placeholder}
                    maxlength={field.maxlength}
                    required={field.required}
                    autocomplete="off"
                    data-profile-field
                    class={inputClass}
                  />
                )}
                {field.key === 'handle' && (
                  <p class={hintClass}>Lowercase letters, digits and hyphens. Your GitHub or X username is a good choice.</p>
                )}
                {field.hint && <p class={hintClass}>{field.hint}</p>}
              </div>
            ))}
          </div>
        </Card>

        <Card as="section" aria-labelledby="stack-heading">
          <div class="p-6 pb-4">
            <SectionLabel label="Step 2" class="mb-1" />
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 id="stack-heading" class="text-lg font-semibold text-neutral-900">Your stack</h2>
              <p class="text-sm text-neutral-500">
                <span data-selected-count class="font-medium text-neutral-900">0</span> selected
                <button type="button" data-clear-picks hidden class="ml-2 text-indigo-600 transition-colors hover:text-indigo-500">Clear</button>
              </p>
            </div>
            <p class="mt-1 text-sm text-neutral-500">Tick what you use. Once ticked, you can add a line on why.</p>
            <div class="relative mt-4">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-neutral-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <input
                type="search"
                data-picker-search
                autocomplete="off"
                spellcheck="false"
                placeholder={`Search ${resources.length} resources...`}
                aria-label="Search resources by name"
                class:list={[inputClass, 'pl-10']}
              />
            </div>
          </div>

          <div class="border-t border-black/[0.06]">
            {groups.map((group) => (
              <fieldset data-picker-group class="min-w-0 border-b border-black/[0.06] last:border-b-0">
                <legend class="sr-only">{group.category.title}</legend>
                <div class="flex items-baseline justify-between gap-4 bg-neutral-50/80 px-6 py-2.5">
                  <p class="font-mono text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500" aria-hidden="true">
                    {group.category.title}
                  </p>
                  <p class="text-xs text-neutral-500">
                    <span data-group-selected hidden class="font-medium text-indigo-600"></span>
                    <span>{group.items.length}</span>
                  </p>
                </div>
                <ul class="divide-y divide-black/[0.05]">
                  {group.items.map((resource) => <StackPick resource={resource} />)}
                </ul>
              </fieldset>
            ))}
            <p data-picker-empty hidden class="px-6 py-10 text-center text-sm text-neutral-500">No resources match your search.</p>
          </div>
        </Card>
      </div>

      <Card as="aside" class="p-5 lg:sticky lg:top-20" aria-labelledby="preview-heading">
        <SectionLabel label="Step 3" class="mb-1" />
        <h2 id="preview-heading" class="text-lg font-semibold text-neutral-900">Publish</h2>
        <p class="mt-1 break-all font-mono text-xs text-neutral-500">
          src/content/stacks/<span data-preview-handle>you</span>.json
        </p>
        <pre data-preview-json class="mt-3 max-h-72 overflow-auto rounded-lg bg-neutral-100 p-4 font-mono text-xs leading-5 text-neutral-800"></pre>
        <ul data-problems aria-live="polite" class="mt-3 space-y-1 text-xs text-amber-700"></ul>
        <div class="mt-4 grid gap-2">
          <Button href={`${REPO_URL}/new/main`} data-open-pr class="h-10 gap-2" aria-disabled="true">
            Open pull request on GitHub
            <ExternalLinkIcon class="h-4 w-4" />
          </Button>
          <CopyButton copyFrom="[data-preview-json]" label="Copy JSON" class="h-10" />
        </div>
        <p class="mt-4 text-xs leading-5 text-neutral-500">
          GitHub opens the new file for you and forks the repository if needed. Commit it, open the pull request, and your page is live once it's merged.
        </p>
        <p class="mt-3 text-xs text-neutral-500">
          Your draft is saved in this browser.
          <button type="button" data-reset-draft class="text-indigo-600 transition-colors hover:text-indigo-500">Start over</button>
        </p>
      </Card>
    </form>
  </PageShell>

  <template data-note-template>
    <div class="stack-pick-note">
      <input
        type="text"
        maxlength={STACK_LIMITS.note}
        placeholder="Why do you use it? Optional; shown instead of the description."
        autocomplete="off"
        class="h-9 w-full rounded-lg bg-white px-3 text-sm text-neutral-900 placeholder-neutral-400 ring-1 ring-inset ring-black/[0.08] transition focus:outline-none focus:ring-2 focus:ring-indigo-500/50"
      />
    </div>
  </template>
</Layout>

<script>
  import {
    PROFILE_FIELDS,
    parseDraft,
    prepareSubmission,
    serializeDraft,
    suggestHandle,
    type PickedResource,
    type Profile,
    type ProfileKey,
  } from '../../lib/stack-builder';

  const DRAFT_KEY = 'stack-builder-draft';

  const form = document.querySelector<HTMLFormElement>('[data-stack-builder]');
  if (!form) throw new Error('Stack builder form missing');

  const repoUrl = form.dataset.repoUrl ?? '';
  const takenHandles = new Set((form.dataset.takenHandles ?? '').split(',').filter(Boolean));

  const profileInputs = new Map<ProfileKey, HTMLInputElement>();
  for (const input of form.querySelectorAll<HTMLInputElement>('[data-profile-field]')) {
    profileInputs.set(input.name as ProfileKey, input);
  }
  const handleInput = profileInputs.get('handle');

  const checkboxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="resource"]'));
  const groups = Array.from(form.querySelectorAll<HTMLElement>('[data-picker-group]'));
  const searchInput = form.querySelector<HTMLInputElement>('[data-picker-search]');
  const pickerEmpty = form.querySelector<HTMLElement>('[data-picker-empty]');
  const selectedCount = form.querySelector<HTMLElement>('[data-selected-count]');
  const clearPicks = form.querySelector<HTMLButtonElement>('[data-clear-picks]');
  const previewHandle = form.querySelector<HTMLElement>('[data-preview-handle]');
  const previewJson = form.querySelector<HTMLElement>('[data-preview-json]');
  const problemsList = form.querySelector<HTMLElement>('[data-problems]');
  const openPr = form.querySelector<HTMLAnchorElement>('[data-open-pr]');
  const resetDraft = form.querySelector<HTMLButtonElement>('[data-reset-draft]');
  const noteTemplate = document.querySelector<HTMLTemplateElement>('[data-note-template]');

  // Suggesting a handle from the first username stops once the visitor edits the handle.
  let handleTouched = false;

  const rowOf = (checkbox: HTMLInputElement) => checkbox.closest<HTMLElement>('[data-pick]');
  const noteInputOf = (checkbox: HTMLInputElement) => rowOf(checkbox)?.querySelector<HTMLInputElement>('input[type="text"]') ?? null;

  function setNoteVisible(checkbox: HTMLInputElement, visible: boolean, note = '') {
    const row = rowOf(checkbox);
    if (!row) return;
    const existing = noteInputOf(checkbox);
    if (visible && !existing && noteTemplate) {
      const fragment = noteTemplate.content.cloneNode(true) as DocumentFragment;
      const input = fragment.querySelector('input');
      const title = row.querySelector('[data-pick-title]')?.textContent?.trim() ?? 'this resource';
      if (input) {
        input.value = note;
        input.setAttribute('aria-label', `Note for ${title}`);
      }
      row.appendChild(fragment);
    } else if (!visible && existing) {
      existing.parentElement?.remove();
    }
  }

  function readProfile(): Profile {
    const profile = {} as Profile;
    for (const field of PROFILE_FIELDS) {
      profile[field.key] = profileInputs.get(field.key)?.value.trim() ?? '';
    }
    return profile;
  }

  function readPicks(): PickedResource[] {
    return checkboxes
      .filter((checkbox) => checkbox.checked)
      .map((checkbox) => ({ id: checkbox.value, note: noteInputOf(checkbox)?.value.trim() ?? '' }));
  }

  function saveDraft(profile: Profile, picks: PickedResource[]) {
    try {
      localStorage.setItem(DRAFT_KEY, serializeDraft(profile, picks));
    } catch {
      // Storage may be unavailable (private mode, quota); the builder still works without it.
    }
  }

  function restoreDraft() {
    let draft;
    try {
      draft = parseDraft(localStorage.getItem(DRAFT_KEY));
    } catch {
      return;
    }
    if (!draft) return;
    for (const [key, input] of profileInputs) {
      input.value = draft.profile[key] ?? '';
    }
    handleTouched = Boolean(draft.profile.handle);
    for (const checkbox of checkboxes) {
      const note = draft.picks[checkbox.value];
      checkbox.checked = note !== undefined;
      setNoteVisible(checkbox, checkbox.checked, note ?? '');
    }
  }

  function updateGroupCounts() {
    for (const group of groups) {
      const selected = group.querySelectorAll('input[name="resource"]:checked').length;
      const badge = group.querySelector<HTMLElement>('[data-group-selected]');
      if (badge) {
        badge.hidden = selected === 0;
        badge.textContent = `${selected} selected · `;
      }
    }
  }

  function update() {
    const profile = readProfile();
    const picks = readPicks();
    const { json, url, problems } = prepareSubmission(profile, picks, takenHandles, repoUrl);

    if (previewHandle) previewHandle.textContent = profile.handle || 'you';
    if (previewJson) previewJson.textContent = json;
    if (selectedCount) selectedCount.textContent = String(picks.length);
    if (clearPicks) clearPicks.hidden = picks.length === 0;

    if (problemsList) {
      problemsList.replaceChildren(
        ...problems.map((problem) => {
          const item = document.createElement('li');
          item.textContent = problem;
          return item;
        }),
      );
    }

    if (openPr) {
      const ready = problems.length === 0;
      openPr.href = url;
      openPr.setAttribute('aria-disabled', String(!ready));
      openPr.tabIndex = ready ? 0 : -1;
    }

    updateGroupCounts();
    saveDraft(profile, picks);
  }

  function filterPicker() {
    const term = searchInput?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    for (const group of groups) {
      let groupVisible = 0;
      for (const row of group.querySelectorAll<HTMLElement>('[data-pick]')) {
        const title = row.querySelector('[data-pick-title]')?.textContent?.toLowerCase() ?? '';
        const match = !term || title.includes(term);
        row.hidden = !match;
        if (match) groupVisible++;
      }
      group.hidden = groupVisible === 0;
      visible += groupVisible;
    }
    if (pickerEmpty) pickerEmpty.hidden = visible > 0;
  }

  form.addEventListener('submit', (event) => event.preventDefault());

  form.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLInputElement && target.name === 'resource') {
      setNoteVisible(target, target.checked);
    }
    update();
  });

  form.addEventListener('input', (event) => {
    const target = event.target;
    if (target === handleInput) handleTouched = true;
    if (handleInput && !handleTouched && (target === profileInputs.get('github') || target === profileInputs.get('x'))) {
      handleInput.value = suggestHandle(profileInputs.get('github')?.value || profileInputs.get('x')?.value || '');
    }
    update();
  });

  searchInput?.addEventListener('input', filterPicker);

  clearPicks?.addEventListener('click', () => {
    for (const checkbox of checkboxes) {
      checkbox.checked = false;
      setNoteVisible(checkbox, false);
    }
    update();
  });

  openPr?.addEventListener('click', (event) => {
    if (openPr.getAttribute('aria-disabled') === 'true') {
      event.preventDefault();
      problemsList?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });

  resetDraft?.addEventListener('click', () => {
    form.reset();
    handleTouched = false;
    for (const checkbox of checkboxes) setNoteVisible(checkbox, false);
    filterPicker();
    update();
  });

  restoreDraft();
  update();
</script>
