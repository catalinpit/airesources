---
import '../../styles/global.css';
import Layout from '../../layouts/layout.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import PageShell from '../../components/ui/Page-Shell.astro';
import ResourceIcon from '../../components/ui/Resource-Icon.astro';
import SectionLabel from '../../components/ui/Section-Label.astro';
import StackAvatar from '../../components/ui/Stack-Avatar.astro';
import { getCollection } from 'astro:content';
import { pluralize } from '../../lib/format';
import { getStacks, stackPath } from '../../lib/stacks';

const stacks = await getStacks();
const resourceCount = (await getCollection('resources')).length;

const description =
  'The AI tools, prompts, and skills developers actually use, published by the people who use them. Browse community stacks or create your own.';

const PREVIEW_ICONS = 6;

const steps = [
  {
    title: 'Pick your tools',
    body: `Choose from ${resourceCount} resources in the directory and add a line on why each one earns its place.`,
  },
  {
    title: 'Open a pull request',
    body: 'The builder prefills your stack file on GitHub. Commit it and open the pull request; no code required.',
  },
  {
    title: 'Share your page',
    body: 'Once merged, your stack is live at airesources.dev/stack/you with a link you can put in your bio.',
  },
];
---

<Layout description={description} pageTitle="AI Stacks">
  <PageShell hero class="pb-16 pt-14 sm:pt-20">
    <header class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
        AI stacks
      </h1>
      <p class="mt-4 text-[15px] leading-6 text-neutral-600 sm:text-lg sm:leading-8">
        The tools, prompts, and skills developers actually use, published by the people who use them.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button href="/stack/new/" class="h-10 px-5">Create your stack</Button>
        <Button variant="tonal" href="#how-it-works" class="h-10">How it works</Button>
      </div>
    </header>

    <section class="mt-14" aria-labelledby="stacks-heading">
      <SectionLabel label={pluralize(stacks.length, 'stack')} class="mb-3" />
      <h2 id="stacks-heading" class="sr-only">Published stacks</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {stacks.map((stack) => {
          const hidden = stack.items.length - PREVIEW_ICONS;
          return (
            <Card
              as="a"
              href={stackPath(stack.handle)}
              class="group flex gap-4 p-5 transition-colors hover:border-black/[0.12] focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40"
            >
              <StackAvatar name={stack.data.name} avatarUrl={stack.avatarUrl} size="md" />
              <div class="min-w-0 flex-1">
                <h3 class="truncate text-[15px] font-semibold leading-6 text-neutral-900 transition-colors group-hover:text-indigo-600">
                  {stack.data.name}
                </h3>
                <p class="mt-0.5 text-xs text-neutral-500">
                  {pluralize(stack.items.length, 'resource')}
                  <span aria-hidden="true"> · </span>
                  {stack.sections.slice(0, 3).map((section) => section.category.title).join(', ')}
                </p>
                {stack.data.bio && (
                  <p class="mt-2 line-clamp-2 text-sm leading-5 text-neutral-600">{stack.data.bio}</p>
                )}
                <div class="mt-4 flex items-center gap-1.5">
                  {stack.items.slice(0, PREVIEW_ICONS).map(({ resource }) => (
                    <ResourceIcon item={resource} />
                  ))}
                  {hidden > 0 && (
                    <span class="inline-flex h-9 items-center rounded-lg bg-black/[0.04] px-2.5 text-xs font-medium text-neutral-500">
                      +{hidden}
                    </span>
                  )}
                </div>
              </div>
            </Card>
          );
        })}
      </div>
    </section>

    <Card as="section" id="how-it-works" class="mt-20 scroll-mt-24 p-6 md:p-8" aria-labelledby="how-heading">
      <SectionLabel label="How it works" class="mb-2" />
      <h2 id="how-heading" class="text-xl font-semibold tracking-tight text-neutral-900 sm:text-2xl">
        Publish your stack in a few minutes
      </h2>
      <ol class="mt-6 grid gap-6 sm:grid-cols-3">
        {steps.map((step, index) => (
          <li class="flex gap-3">
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-indigo-600 font-mono text-xs font-semibold text-white">
              {index + 1}
            </span>
            <div class="min-w-0">
              <h3 class="font-medium leading-7 text-neutral-900">{step.title}</h3>
              <p class="mt-1 text-sm leading-6 text-neutral-600">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/stack/new/" class="h-10 px-5">Create your stack</Button>
        <p class="text-sm text-neutral-500">
          Prefer editing files? Add <code class="rounded bg-black/[0.05] px-1.5 py-0.5 font-mono text-[13px] text-neutral-800">src/content/stacks/you.json</code> by hand and open a pull request.
        </p>
      </div>
    </Card>
  </PageShell>
</Layout>
