---
import '../../styles/global.css';
import Layout from '../../layouts/layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageShell from '../../components/ui/Page-Shell.astro';
import ResourceList from '../../components/ui/Resource-List.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import SponsoredProducts from '../../components/ui/Sponsored-Products.astro';
import { getCollection } from 'astro:content';
import { resourcePath } from '../../lib/resources';
import { SITE_URL } from '../../lib/site';
import { schemaOrgType, toJsonLd } from '../../lib/structured-data';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const resources = await getCollection('resources');

  return categories.map(category => {
    const categoryItems = resources
      .filter(r => r.data.categorySlug === category.data.categorySlug)
      .map(r => r.data);

    return {
      params: { slug: category.data.categorySlug },
      props: {
        category: category.data,
        items: categoryItems
      }
    };
  });
}

const { category, items } = Astro.props;

const siteUrl = Astro.site ?? SITE_URL;
const categoryUrl = new URL(`/category/${category.categorySlug}/`, siteUrl).href;

const allResources = await getCollection('resources');
const allItems = allResources.map(r => ({
  ...r.data,
  categorySlug: r.data.categorySlug
}));

const categoryItems = items
	.filter(item => !item.sponsored || item.sponsored === "small")
	.sort((a, b) => a.name.localeCompare(b.name));

---

<Layout description={category.description} pageTitle={category.title}>
	<script is:inline type="application/ld+json" set:html={toJsonLd({
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"name": category.title,
		"description": category.description,
		"url": categoryUrl,
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Resources",
					"item": siteUrl
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": category.title,
					"item": categoryUrl
				}
			]
		},
		"mainEntity": {
			"@type": "ItemList",
			"numberOfItems": categoryItems.length,
			"itemListElement": categoryItems.map((item, index) => ({
				"@type": "ListItem",
				"position": index + 1,
				"item": {
					"@type": schemaOrgType(item),
					"name": item.name,
					"description": item.description,
					"url": new URL(resourcePath(item), siteUrl).href
				}
			}))
		}
	})} />
	<PageShell>
		<Breadcrumbs class="mb-8" items={[{ label: 'Resources', href: '/' }, { label: category.title }]} />

		<header class="mb-8">
			<h1 class="text-2xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">
				{category.title}
			</h1>
			<p class="mt-3 max-w-2xl text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-7">
				{category.description}
			</p>
		</header>

		<SponsoredProducts items={allItems} class="mb-10" />

		<section class="mb-20">
			<FilterBar allResources={categoryItems} />
			<ResourceList items={categoryItems} />
		</section>
	</PageShell>
</Layout>
