---
import '../../styles/global.css';
import Layout from '../../layouts/layout.astro';
import ResourceList from '../../components/ui/Resource-List.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import SponsoredProducts from '../../components/ui/Sponsored-Products.astro';
import { getCollection } from 'astro:content';
import { resourcePath } from '../../lib/resources';
import { schemaOrgType } from '../../lib/structured-data';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const resources = await getCollection('resources');

  return categories.map(category => {
    const categoryItems = resources
      .filter(r => r.data.categorySlug === category.data.categorySlug)
      .map(r => r.data);

    return {
      params: { slug: category.data.categorySlug },
      props: {
        category: category.data,
        items: categoryItems
      }
    };
  });
}

const { category, items } = Astro.props;

const siteUrl = Astro.site || 'https://airesources.dev';
const categoryUrl = new URL(`/category/${category.categorySlug}/`, siteUrl).href;

const allResources = await getCollection('resources');
const allItems = allResources.map(r => ({
  ...r.data,
  categorySlug: r.data.categorySlug
}));

const categoryItems = items
	.filter(item => !item.sponsored || item.sponsored === "small")
	.sort((a, b) => a.name.localeCompare(b.name));

---

<Layout description={category.description} pageTitle={category.title}>
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"name": category.title,
		"description": category.description,
		"url": categoryUrl,
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Resources",
					"item": siteUrl
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": category.title,
					"item": categoryUrl
				}
			]
		},
		"mainEntity": {
			"@type": "ItemList",
			"numberOfItems": categoryItems.length,
			"itemListElement": categoryItems.map((item, index) => ({
				"@type": "ListItem",
				"position": index + 1,
				"item": {
					"@type": schemaOrgType(item),
					"name": item.name,
					"description": item.description,
					"url": new URL(resourcePath(item), siteUrl).href
				}
			}))
		}
	})} />
	<div class="relative isolate min-h-screen overflow-hidden bg-neutral-50 text-neutral-900">
		<div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[24rem] bg-[radial-gradient(50rem_18rem_at_50%_-8rem,rgba(99,102,241,0.12),transparent_70%)]"></div>
		<div class="mx-auto max-w-4xl px-3 py-10 sm:px-6 lg:px-8">
		<nav class="mb-8" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-500" itemscope itemtype="https://schema.org/BreadcrumbList">
				<li class="whitespace-nowrap" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<a href="/" class="transition-colors hover:text-neutral-900" itemprop="item">
						<span itemprop="name">Resources</span>
					</a>
					<meta itemprop="position" content="1" />
				</li>
				<span aria-hidden="true">/</span>
				<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<span class="font-medium text-neutral-900" itemprop="name" aria-current="page">{category.title}</span>
					<meta itemprop="position" content="2" />
				</li>
			</ol>
		</nav>

		<header class="mb-8">
			<h1 class="text-2xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">
				{category.title}
			</h1>
			<p class="mt-3 max-w-2xl text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-7">
				{category.description}
			</p>
		</header>

		<SponsoredProducts items={allItems} class="mb-10" />

		<section class="mb-20">
			<FilterBar allResources={categoryItems} />
			<ResourceList items={categoryItems} />
		</section>
		</div>
	</div>
</Layout>
