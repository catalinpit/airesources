---
import '../../styles/global.css';
import Layout from '../../layouts/layout.astro';
import ResourceList from '../../components/ui/Resource-List.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import SponsoredProducts from '../../components/ui/Sponsored-Products.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const resources = await getCollection('resources');

  return categories.map(category => {
    const categoryItems = resources
      .filter(r => r.data.categorySlug === category.data.categorySlug)
      .map(r => r.data);

    return {
      params: { slug: category.data.categorySlug },
      props: {
        category: category.data,
        items: categoryItems
      }
    };
  });
}

const { category, items } = Astro.props;

const siteUrl = Astro.site || 'https://airesources.dev';
const categoryUrl = new URL(`/category/${category.categorySlug}/`, siteUrl).href;

const allResources = await getCollection('resources');
const allItems = allResources.map(r => ({
  ...r.data,
  categorySlug: r.data.categorySlug
}));

const categoryItems = items
	.filter(item => !item.sponsored || item.sponsored === "small")
	.sort((a, b) => a.name.localeCompare(b.name));

const activeFilters = {
	techStack: [],
	features: [],
	badges: [],
	pricing: [],
	integrations: [],
};
---

<Layout description={category.description} pageTitle={category.title}>
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"name": category.title,
		"description": category.description,
		"url": categoryUrl,
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Resources",
					"item": siteUrl
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": category.title,
					"item": categoryUrl
				}
			]
		},
		"mainEntity": {
			"@type": "ItemList",
			"numberOfItems": categoryItems.length,
			"itemListElement": categoryItems.map((item, index) => ({
				"@type": "ListItem",
				"position": index + 1,
				"item": {
					"@type": "SoftwareApplication",
					"name": item.name,
					"description": item.description,
					"url": new URL(`/${category.categorySlug}/${item.name.toLowerCase().replace(/\s+/g, '-')}/`, siteUrl).href
				}
			}))
		}
	})} />
	<div class="relative isolate min-h-screen overflow-hidden bg-[#090a0f] text-white">
		<div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(129,140,248,0.08)_0%,transparent_22rem)]"></div>
		<div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
		<nav class="mb-8" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-2 text-sm text-neutral-400" itemscope itemtype="https://schema.org/BreadcrumbList">
				<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<a href="/" class="transition-colors hover:text-white" itemprop="item">
						<span itemprop="name">Resources</span>
					</a>
					<meta itemprop="position" content="1" />
				</li>
				<span aria-hidden="true">/</span>
				<li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
					<span class="font-medium text-white" itemprop="name" aria-current="page">{category.title}</span>
					<meta itemprop="position" content="2" />
				</li>
			</ol>
		</nav>

		<header class="mb-8">
			<div>
				<h1 class="text-3xl font-semibold tracking-tight text-white">
					{category.title}
				</h1>
				<p class="mt-2 max-w-2xl text-sm leading-6 text-neutral-300">
					{category.description}
				</p>
			</div>
		</header>

		<SponsoredProducts items={allItems} class="mb-10" />

		<section class="mb-20">
			<FilterBar allResources={categoryItems} activeFilters={activeFilters} />
			<ResourceList items={categoryItems} />
		</section>
		</div>
	</div>
</Layout>
