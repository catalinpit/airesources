---
import '../../styles/global.css';
import Layout from '../../layouts/layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import CopyButton from '../../components/ui/Copy-Button.astro';
import PageShell from '../../components/ui/Page-Shell.astro';
import Tag from '../../components/ui/Tag.astro';
import Divider from '../../components/ui/Divider.astro';
import SectionHeading from '../../components/ui/Section-Heading.astro';
import SectionLabel from '../../components/ui/Section-Label.astro';
import SponsoredProducts from '../../components/ui/Sponsored-Products.astro';
import ResourceIcon from '../../components/ui/Resource-Icon.astro';
import ResourceAuthor from '../../components/ui/Resource-Author.astro';
import ResourceList from '../../components/ui/Resource-List.astro';
import CourseCurriculum from '../../components/ui/Course-Curriculum.astro';
import AccessNote from '../../components/ui/Access-Note.astro';
import HighlightIcon from '../../components/ui/Highlight-Icon.astro';
import ExternalLinkIcon from '../../components/icons/ExternalLinkIcon.astro';
import InfoIcon from '../../components/icons/InfoIcon.astro';
import { getCollection } from 'astro:content';
import { PRICING_LABELS, isFreeOnly } from '../../lib/pricing';
import { curriculumSummary, resourceKind, resourceSlug, reusableContentOf } from '../../lib/resources';
import { packRelations, relatedResources } from '../../lib/related';
import { resourceStructuredData, toJsonLd } from '../../lib/structured-data';

const RELATED_LIMIT = 6;

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const resources = await getCollection('resources');

  return resources.map(resource => {
    const category = categories.find(c => c.data.categorySlug === resource.data.categorySlug);
    if (!category) {
      throw new Error(`${resource.filePath ?? resource.id}: unknown category "${resource.data.categorySlug}"; add it to src/content/categories/.`);
    }

    return {
      params: {
        category: resource.data.categorySlug,
        product: resourceSlug(resource.data.name),
      },
      props: {
        category: category.data,
        item: resource.data,
      },
    };
  });
}

const { category, item } = Astro.props;

const allItems = (await getCollection('resources')).map(r => r.data);
const otherItems = allItems.filter(other => other.name !== item.name || other.categorySlug !== item.categorySlug);

const kind = resourceKind(item);
const authorLabel = kind === 'course' ? 'Author' : 'Created by';

const reusableContent = reusableContentOf(item);
const reusable = kind === 'reusable' && reusableContent
  ? {
      content: reusableContent,
      label: item.skill ? 'Skill' : item.prompt ? 'Prompt' : 'Use Case',
      isLong: reusableContent.length > 2000 || reusableContent.split('\n').length > 30,
    }
  : undefined;

// The header already shows "Free", so a free-only tier list only renders when it has details to add
const isFree = item.pricing !== undefined && isFreeOnly(item.pricing);
const pricing = item.pricing && (!isFree || item.pricing.details) ? item.pricing : undefined;

// Tools show the access note in the Platforms section instead of the header
const headerNote = [curriculumSummary(item), kind === 'tool' ? undefined : item.accessNote].filter(Boolean).join('. ');

const highlights = kind === 'tool' ? item.highlights ?? [] : [];
const models = kind === 'tool' ? item.models ?? [] : [];
const platforms = kind === 'tool' ? item.platforms ?? [] : [];
const availability = kind === 'tool' ? item.accessNote : undefined;
const hasToolDetails = highlights.length > 0 || models.length > 0 || platforms.length > 0 || Boolean(availability);

const related = kind === 'course'
  ? relatedResources(item, allItems, { limit: RELATED_LIMIT, categoryTitle: category.title })
  : packRelations(item, allItems);

const structuredData = resourceStructuredData(item, { categoryTitle: category.title });

const breadcrumbs = [
  { label: 'Resources', href: '/' },
  { label: category.title, href: `/category/${category.categorySlug}/` },
  { label: item.name },
];
---

<Layout description={item.description} pageTitle={item.name}>
  <script is:inline type="application/ld+json" set:html={toJsonLd(structuredData)} />
  <PageShell>
    <Breadcrumbs class="mx-auto mb-6 max-w-3xl" items={breadcrumbs} />

    {otherItems.length > 0 && <SponsoredProducts items={otherItems} class="max-w-3xl mx-auto" />}

    <main>
      <div class="max-w-3xl mx-auto">
        <div class="rounded-xl border border-black/[0.06] bg-white shadow-[0_8px_30px_rgba(0,0,0,0.04)]">
          <div class="p-6 md:p-8">
            <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start">
              <ResourceIcon item={item} size="lg" />
              <div class="min-w-0">
                <p class="mb-2 font-mono text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">
                  {category.title}{isFree && <><span aria-hidden="true"> · </span>Free</>}
                </p>
                <h1 class="break-words text-2xl font-semibold tracking-tight text-neutral-900 sm:text-3xl md:text-4xl">
                  {item.name}
                </h1>
                <p class="mt-3 text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-7">
                  {item.description}
                </p>
                {headerNote && (
                  <AccessNote text={headerNote} class="mt-3 text-sm leading-6 text-neutral-500" />
                )}
                {kind === 'course' && item.link && (
                  <Button href={item.link} class="mt-5 h-10 px-5">
                    View course
                    <ExternalLinkIcon class="w-4 h-4 ml-2" />
                  </Button>
                )}
              </div>
            </div>

            {reusable && (
              <>
                {item.tags && item.tags.length > 0 && (
                  <div class="mb-6">
                    <div class="flex flex-wrap items-center gap-2">
                      {item.tags.map(tag => (
                        <span class="inline-flex items-center rounded-md bg-black/[0.04] px-2.5 py-1 text-xs text-neutral-600">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
                <Divider class="mb-8" />
                <div class="space-y-4">
                  <div class="flex items-center justify-between">
                    <SectionHeading>{reusable.label}</SectionHeading>
                    <CopyButton
                      copyFrom="#resource-content"
                      class="h-8 px-3"
                      title={`Copy ${reusable.label.toLowerCase()} to clipboard`}
                    />
                  </div>
                  <div class="relative">
                    <div
                      id="resource-content"
                      class:list={[
                        "rounded-lg bg-neutral-100 p-6 font-mono text-sm leading-6 text-neutral-800 whitespace-pre-line",
                        reusable.isLong && "max-h-[30rem] overflow-hidden"
                      ]}
                    >
                      {reusable.content}
                    </div>
                    {reusable.isLong && (
                      <div id="resource-content-fade" class="pointer-events-none absolute inset-x-0 bottom-0 h-28 rounded-b-lg bg-gradient-to-t from-neutral-100 to-transparent"></div>
                    )}
                  </div>
                  {reusable.isLong && (
                    <div class="flex justify-center">
                      <Button variant="tonal" id="expand-resource-content" class="h-8 gap-1.5 px-3.5">
                        Show full {reusable.label.toLowerCase()}
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </Button>
                    </div>
                  )}
                  {item.example && (
                    <div class="mt-6">
                      <SectionHeading>Usage Example</SectionHeading>
                      <div
                        class="example-content mt-4 rounded-lg bg-indigo-50 p-6 font-mono text-sm leading-6 text-neutral-800 whitespace-pre-line"
                      >
                        {item.example}
                      </div>
                    </div>
                  )}
                  {(item.author || item.link) && (
                    <div class="mt-8 space-y-4 border-t border-black/[0.06] pt-8">
                      {item.author && <ResourceAuthor author={item.author} label={authorLabel} />}
                      {item.link && (
                        <div>
                          <a
                            href={item.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 text-sm text-indigo-600 transition-colors hover:text-indigo-500"
                          >
                            <ExternalLinkIcon class="w-4 h-4" />
                            View source
                            <span class="sr-only">(opens in new tab)</span>
                          </a>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </>
            )}

            {kind === 'course' && item.curriculum && item.curriculum.length > 0 && (
              <>
                <Divider class="mb-8" />
                <CourseCurriculum curriculum={item.curriculum} />
              </>
            )}

            {hasToolDetails && (
              <>
                <Divider class="my-8" />
                <div class="space-y-8">
                  {highlights.length > 0 && (
                    <section>
                      <SectionHeading class="mb-4">Highlights</SectionHeading>
                      <ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
                        {highlights.map(highlight => (
                          <li class="flex gap-3">
                            <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
                              <HighlightIcon name={highlight.icon} class="h-[18px] w-[18px]" />
                            </span>
                            <div class="min-w-0">
                              <h4 class="font-medium leading-6 text-neutral-900">{highlight.title}</h4>
                              <p class="mt-1 text-sm leading-6 text-neutral-600">{highlight.description}</p>
                            </div>
                          </li>
                        ))}
                      </ul>
                    </section>
                  )}

                  {models.length > 0 && (
                    <section>
                      <SectionHeading class="mb-4">Available Models</SectionHeading>
                      <div class="flex flex-wrap gap-2">
                        {models.map(model => (
                          <span class="inline-flex items-center rounded-md bg-black/[0.04] px-3 py-1 text-sm text-neutral-600">
                            {model}
                          </span>
                        ))}
                      </div>
                    </section>
                  )}

                  {(platforms.length > 0 || availability) && (
                    <section>
                      <SectionHeading class="mb-4">{platforms.length > 0 ? 'Platforms' : 'Availability'}</SectionHeading>
                      {platforms.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                          {platforms.map(platform => (
                            <span class="inline-flex items-center rounded-md bg-black/[0.04] px-3 py-1 text-sm text-neutral-600">
                              {platform}
                            </span>
                          ))}
                        </div>
                      )}
                      {availability && (
                        <AccessNote text={availability} class="mt-3 text-sm leading-6 text-neutral-600" />
                      )}
                    </section>
                  )}
                </div>
              </>
            )}

            {pricing && (
              <div class="mt-8 space-y-4">
                <div class="flex items-center justify-between gap-4">
                  <SectionHeading>Pricing</SectionHeading>
                  {!isFree && (
                    <span class="inline-flex items-center rounded-md bg-black/[0.04] px-3 py-1 text-sm font-medium text-neutral-600">
                      {PRICING_LABELS[pricing.type]}
                    </span>
                  )}
                </div>
                {!isFree && (
                  <div class="grid gap-3">
                    {pricing.tiers.map(tier => (
                      <div class="flex items-center justify-between gap-4 rounded-lg bg-neutral-100 px-4 py-3">
                        <span class="font-medium text-neutral-900">{tier.name}</span>
                        <span class="rounded-md bg-black/[0.06] px-3 py-1.5 text-sm font-semibold text-neutral-900">{tier.price}</span>
                      </div>
                    ))}
                  </div>
                )}
                {pricing.details && (
                  <div class="flex items-start gap-2.5 rounded-lg bg-neutral-100 p-4 text-sm text-neutral-600">
                    <InfoIcon class="w-4 h-4 mt-0.5 flex-shrink-0 text-indigo-600" />
                    <span>{pricing.details}</span>
                  </div>
                )}
              </div>
            )}

            {kind === 'tool' && (
              <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex flex-wrap gap-2">
                  <Tag href={`/category/${category.categorySlug}/`} class="whitespace-nowrap">
                    #{item.type ?? 'tool'}
                  </Tag>
                </div>
                <Button href={item.link} class="h-10 w-full justify-center whitespace-nowrap px-5 sm:w-auto">
                  Check out site
                  <ExternalLinkIcon class="w-4 h-4 ml-2" />
                </Button>
              </div>
            )}

            {(kind === 'course' || kind === 'tool') && item.author && (
              <div class="mt-8 border-t border-black/[0.06] pt-8">
                <ResourceAuthor author={item.author} label={authorLabel} />
              </div>
            )}
          </div>
        </div>

        {related && related.items.length > 0 && (
          <section class="mt-10">
            <SectionLabel label={related.label} class="mb-3" />
            <ResourceList items={related.items} showAuthor={!related.sameAuthor} />
          </section>
        )}
      </div>
    </main>
  </PageShell>
  {reusable?.isLong && (
    <script>
      const resourceContent = document.getElementById('resource-content');
      const expandBtn = document.getElementById('expand-resource-content');
      const contentFade = document.getElementById('resource-content-fade');

      expandBtn?.addEventListener('click', () => {
        resourceContent?.classList.remove('max-h-[30rem]', 'overflow-hidden');
        contentFade?.remove();
        expandBtn.remove();
      });
    </script>
  )}
</Layout>
