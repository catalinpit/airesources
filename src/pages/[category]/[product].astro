---
import '../../styles/global.css';
import Layout from '../../layouts/layout.astro';
import Button from '../../components/ui/Button.astro';
import Tag from '../../components/ui/Tag.astro';
import Divider from '../../components/ui/Divider.astro';
import SponsoredProducts from '../../components/ui/Sponsored-Products.astro';
import ResourceIcon from '../../components/ui/Resource-Icon.astro';
import ResourceAuthor from '../../components/ui/Resource-Author.astro';
import CopyIcon from '../../components/icons/CopyIcon.astro';
import CheckIcon from '../../components/icons/CheckIcon.astro';
import ExternalLinkIcon from '../../components/icons/ExternalLinkIcon.astro';
import InfoIcon from '../../components/icons/InfoIcon.astro';
import { getCollection } from 'astro:content';
import { PRICING_LABELS, isFreeOnly } from '../../lib/pricing';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const resources = await getCollection('resources');

  return resources.map(resource => {
    const category = categories.find(c => c.data.categorySlug === resource.data.categorySlug);

    return {
      params: {
        category: resource.data.categorySlug,
        product: resource.data.name.toLowerCase().replace(/\s+/g, '-'),
      },
      props: {
        category: category?.data,
        item: resource.data,
      },
    };
  });
}

const { category, item } = Astro.props;

const siteUrl = Astro.site || 'https://airesources.dev';
const productUrl = new URL(`/${category.categorySlug}/${item.name.toLowerCase().replace(/\s+/g, '-')}/`, siteUrl).href;
const categoryUrl = new URL(`/category/${category.categorySlug}/`, siteUrl).href;

const tags = [
  { label: item.type || 'tool', href: '#' },
];

const allResources = await getCollection('resources');
const allItems = allResources.map(r => ({
  ...r.data,
  categorySlug: r.data.categorySlug
}));

const filteredItems = allItems.filter(product =>
  product.name !== item.name || product.categorySlug !== category.categorySlug
);

const reusableContent = item.skill || item.prompt || item.useCase;
const reusableContentLabel = item.skill ? 'Skill' : item.prompt ? 'Prompt' : 'Use Case';
const sectionHeadingClass = 'text-lg font-semibold leading-6 text-neutral-900';
const tonalButtonClass = 'inline-flex items-center gap-1.5 rounded-lg bg-black/[0.04] text-sm font-medium text-neutral-700 transition-colors hover:bg-black/[0.08] hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40';
const isLongContent = Boolean(reusableContent) && (reusableContent.length > 2000 || reusableContent.split('\n').length > 30);
const authorLabel = item.type === 'course' ? 'Author' : 'Created by';
const showPricingType = Boolean(item.pricing) && !isFreeOnly(item.pricing!);

let lessonCounter = 0;
const curriculum = (item.curriculum ?? []).map(module => {
  const firstLessonNumber = lessonCounter + 1;
  lessonCounter += module.lessons.length;
  return { ...module, firstLessonNumber };
});
const lessonCount = lessonCounter;
const isSingleModule = curriculum.length === 1;
const curriculumSummary = isSingleModule
  ? `${lessonCount} lessons`
  : `${curriculum.length} modules · ${lessonCount} lessons`;
---

<Layout description={item.description} pageTitle={item.name}>
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		"name": item.name,
		"description": item.description,
		...(item.link && { "url": item.link }),
		"applicationCategory": category.title,
		"operatingSystem": "Web",
		"offers": item.pricing ? {
			"@type": "Offer",
			"priceCurrency": "USD",
			"price": item.pricing.type === "free" ? "0" : undefined,
			"priceSpecification": item.pricing.tiers?.map(tier => ({
				"@type": "UnitPriceSpecification",
				"name": tier.name,
				"price": tier.price
			}))
		} : undefined,
		"breadcrumb": {
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Resources",
					"item": siteUrl
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": category.title,
					"item": categoryUrl
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": item.name,
					"item": productUrl
				}
			]
		}
	})} />
  <div class="relative isolate min-h-screen overflow-hidden bg-neutral-50 text-neutral-900">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[24rem] bg-[radial-gradient(50rem_18rem_at_50%_-8rem,rgba(99,102,241,0.12),transparent_70%)]"></div>
  <div class="mx-auto max-w-4xl px-3 py-10 sm:px-6 lg:px-8">
    <nav class="mx-auto mb-6 max-w-3xl" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-500" itemscope itemtype="https://schema.org/BreadcrumbList">
        <li class="whitespace-nowrap" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="/" class="transition-colors hover:text-neutral-900" itemprop="item">
            <span itemprop="name">Resources</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        <span aria-hidden="true">/</span>
        <li class="whitespace-nowrap" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href={`/category/${category.categorySlug}/`} class="transition-colors hover:text-neutral-900" itemprop="item">
            <span itemprop="name">{category.title}</span>
          </a>
          <meta itemprop="position" content="2" />
        </li>
        <span aria-hidden="true">/</span>
        <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="font-medium text-neutral-900" itemprop="name" aria-current="page">{item.name}</span>
          <meta itemprop="position" content="3" />
        </li>
      </ol>
    </nav>

    {filteredItems.length > 0 && <SponsoredProducts items={filteredItems} class="max-w-3xl mx-auto" />}

    <main>
      <div class="max-w-3xl mx-auto">
        <div class="rounded-xl border border-black/[0.06] bg-white shadow-[0_8px_30px_rgba(0,0,0,0.04)]">
          <div class="p-6 md:p-8">
            <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start">
              <ResourceIcon item={item} size="lg" />
              <div class="min-w-0">
                <p class="mb-2 font-mono text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">
                  {category.title}
                </p>
                <h1 class="break-words text-2xl font-semibold tracking-tight text-neutral-900 sm:text-3xl md:text-4xl">
                  {item.name}
                </h1>
                <p class="mt-3 text-[15px] leading-6 text-neutral-600 sm:text-base sm:leading-7">
                  {item.description}
                </p>
              </div>
            </div>

            {reusableContent && (
              <>
                {item.tags && item.tags.length > 0 && (
                  <div class="mb-6">
                    <div class="flex flex-wrap items-center gap-2">
                      {item.tags.map(tag => (
                        <span class="inline-flex items-center rounded-md bg-black/[0.04] px-2.5 py-1 text-xs text-neutral-600">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
                <Divider class="mb-8" />
                <div class="space-y-4">
                  <div class="flex items-center justify-between">
                    <h3 class={sectionHeadingClass}>{reusableContentLabel}</h3>
                    <button
                      id="copy-resource-content-btn"
                      type="button"
                      class:list={[tonalButtonClass, "px-3 py-1.5"]}
                      title={`Copy ${reusableContentLabel.toLowerCase()} to clipboard`}
                    >
                      <CopyIcon id="copy-icon" class="w-4 h-4" />
                      <CheckIcon id="check-icon" class="w-4 h-4 hidden" />
                      <span id="copy-text">Copy</span>
                    </button>
                  </div>
                  <div class="relative">
                    <div
                      id="resource-content"
                      class:list={[
                        "rounded-lg bg-neutral-100 p-6 font-mono text-sm leading-6 text-neutral-800 whitespace-pre-line",
                        isLongContent && "max-h-[30rem] overflow-hidden"
                      ]}
                    >
                      {reusableContent}
                    </div>
                    {isLongContent && (
                      <div id="resource-content-fade" class="pointer-events-none absolute inset-x-0 bottom-0 h-28 rounded-b-lg bg-gradient-to-t from-neutral-100 to-transparent"></div>
                    )}
                  </div>
                  {isLongContent && (
                    <div class="flex justify-center">
                      <button
                        id="expand-resource-content"
                        type="button"
                        class:list={[tonalButtonClass, "px-3.5 py-1.5"]}
                      >
                        Show full {reusableContentLabel.toLowerCase()}
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </button>
                    </div>
                  )}
                  {item.example && (
                    <div class="mt-6">
                      <h3 class={sectionHeadingClass}>Usage Example</h3>
                      <div
                        class="example-content mt-4 rounded-lg bg-indigo-50 p-6 font-mono text-sm leading-6 text-neutral-800 whitespace-pre-line"
                      >
                        {item.example}
                      </div>
                    </div>
                  )}
                  {(item.author || item.link) && (
                    <div class="mt-8 space-y-4 border-t border-black/[0.06] pt-8">
                      {item.author && <ResourceAuthor author={item.author} label={authorLabel} />}
                      {item.link && (
                        <div>
                          <a
                            href={item.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 text-sm text-indigo-600 transition-colors hover:text-indigo-500"
                          >
                            <ExternalLinkIcon class="w-4 h-4" />
                            View source
                          </a>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </>
            )}

            {curriculum.length > 0 && (
              <>
                <Divider class="mb-8" />
                <section class="space-y-4">
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                    <h3 class={sectionHeadingClass}>Curriculum</h3>
                    <span class="text-sm text-neutral-500">{curriculumSummary}</span>
                  </div>
                  <ol class="space-y-3">
                    {curriculum.map((module, moduleIndex) => (
                      <li class="rounded-lg bg-neutral-100 p-5">
                        {!isSingleModule && (
                          <div class="flex items-start gap-3">
                            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-md bg-indigo-600 text-[11px] font-semibold text-white">
                              {moduleIndex + 1}
                            </span>
                            <div class="min-w-0 flex-1">
                              <h4 class="text-base font-semibold leading-none text-neutral-900">{module.title}</h4>
                              {module.description && (
                                <p class="mt-2 text-sm leading-6 text-neutral-600">{module.description}</p>
                              )}
                            </div>
                          </div>
                        )}
                        <ol class:list={["sm:columns-2 sm:gap-x-6", !isSingleModule && "mt-2 pl-9"]}>
                          {module.lessons.map((lesson, lessonIndex) => (
                            <li class="flex break-inside-avoid items-baseline gap-2 py-[3px] text-sm leading-6 text-neutral-700">
                              <span class="font-mono text-[11px] text-neutral-400">
                                {String(module.firstLessonNumber + lessonIndex).padStart(2, '0')}
                              </span>
                              <span>{lesson}</span>
                            </li>
                          ))}
                        </ol>
                      </li>
                    ))}
                  </ol>
                </section>
              </>
            )}

            {!reusableContent && item.models && item.models.length > 0 && (
              <Divider class="my-8" />
              <h3 class:list={[sectionHeadingClass, "mb-4"]}>Available Models</h3>
                <div class="flex flex-wrap gap-2">
                  {item.models.map(model => (
                    <span class="inline-flex items-center rounded-md bg-black/[0.04] px-3 py-1 text-sm text-neutral-600">
                      {model}
                    </span>
                  ))}
                </div>
            )}

            {item.pricing && (
              <div class="mt-8 space-y-4">
                  <div class="flex items-center justify-between gap-4">
                    <h3 class={sectionHeadingClass}>Pricing</h3>
                    {showPricingType && (
                      <span class="inline-flex items-center rounded-md bg-black/[0.04] px-3 py-1 text-sm font-medium text-neutral-600">
                        {PRICING_LABELS[item.pricing.type]}
                      </span>
                    )}
                  </div>
                  <div class="grid gap-3">
                    {item.pricing.tiers.map(tier => (
                      <div class="flex items-center justify-between gap-4 rounded-lg bg-neutral-100 px-4 py-3">
                        <span class="font-medium text-neutral-900">{tier.name}</span>
                        <span class="rounded-md bg-black/[0.06] px-3 py-1.5 text-sm font-semibold text-neutral-900">{tier.price}</span>
                      </div>
                    ))}
                  </div>
                  {item.pricing.details && (
                    <div class="flex items-start gap-2.5 rounded-lg bg-neutral-100 p-4 text-sm text-neutral-600">
                      <InfoIcon class="w-4 h-4 mt-0.5 flex-shrink-0 text-indigo-600" />
                      <span>{item.pricing.details}</span>
                    </div>
                  )}
              </div>
            )}

            {!reusableContent && (
            <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex flex-wrap gap-2">
                {tags.map(tag => (
                  <Tag href={`/category/${category.categorySlug}/`} class="whitespace-nowrap">
                    #{tag.label}
                  </Tag>
                ))}
              </div>
              <Button href={item.link} class="h-10 w-full justify-center whitespace-nowrap px-5 sm:w-auto">
                Check out site
                <ExternalLinkIcon class="w-4 h-4 ml-2" />
              </Button>
            </div>
            )}

            {!reusableContent && item.author && (
              <div class="mt-8 border-t border-black/[0.06] pt-8">
                <ResourceAuthor author={item.author} label={authorLabel} />
              </div>
            )}
          </div>
        </div>
      </div>
    </main>
  </div>
  {reusableContent && (
    <script>
      async function writeClipboardText(text: string) {
        await navigator.clipboard.writeText(text);
      }

      const copyBtn = document.getElementById('copy-resource-content-btn');
      const copyIcon = document.getElementById('copy-icon');
      const checkIcon = document.getElementById('check-icon');
      const copyText = document.getElementById('copy-text');
      const resourceContent = document.getElementById('resource-content');
      const expandBtn = document.getElementById('expand-resource-content');
      const contentFade = document.getElementById('resource-content-fade');

      expandBtn?.addEventListener('click', () => {
        resourceContent?.classList.remove('max-h-[30rem]', 'overflow-hidden');
        contentFade?.remove();
        expandBtn.remove();
      });

      copyBtn?.addEventListener('click', async () => {
        const text = resourceContent?.textContent || resourceContent?.innerText || '';
        try {
          await writeClipboardText(text);
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          copyText && (copyText.textContent = 'Copied!');
          copyBtn.classList.remove('text-neutral-700');
          copyBtn.classList.add('text-green-600');
          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            copyText && (copyText.textContent = 'Copy');
            copyBtn.classList.remove('text-green-600');
            copyBtn.classList.add('text-neutral-700');
          }, 2000);
        } catch {
          copyText && (copyText.textContent = 'Failed');
          setTimeout(() => copyText && (copyText.textContent = 'Copy'), 2000);
        }
      });
    </script>
  )}
  </div>
</Layout>
