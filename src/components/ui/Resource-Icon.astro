---
import type { CollectionEntry } from 'astro:content';
import PromptIcon from '../icons/PromptIcon.astro';
import SkillIcon from '../icons/SkillIcon.astro';
import UseCaseIcon from '../icons/UseCaseIcon.astro';

type Resource = Pick<CollectionEntry<'resources'>['data'], 'name' | 'iconUrl' | 'prompt' | 'skill' | 'useCase'>;

interface Props {
  item: Resource;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { item, size = 'sm', class: className } = Astro.props;

const hues = [
  'bg-rose-100 text-rose-700',
  'bg-amber-100 text-amber-700',
  'bg-emerald-100 text-emerald-700',
  'bg-sky-100 text-sky-700',
  'bg-indigo-100 text-indigo-700',
  'bg-violet-100 text-violet-700',
  'bg-fuchsia-100 text-fuchsia-700',
  'bg-teal-100 text-teal-700',
];

const hash = Array.from(item.name).reduce((acc, char) => (acc * 31 + char.charCodeAt(0)) >>> 0, 7);
const hue = hues[hash % hues.length];
const initial = item.name.charAt(0).toUpperCase();
const hasFavicon = Boolean(item.iconUrl) && !item.iconUrl!.includes('github.com/favicon.ico');

const TypeIcon = item.skill ? SkillIcon : item.prompt ? PromptIcon : item.useCase ? UseCaseIcon : null;
const typeTint = item.skill
  ? 'bg-emerald-100 text-emerald-700'
  : item.prompt
    ? 'bg-indigo-100 text-indigo-700'
    : 'bg-sky-100 text-sky-700';

// All sizes are styled by .resource-icon below; "sm" is the default and the
// others are selected by the data-size attribute. The tile is a span (displayed
// flex) rather than a div so it is valid inside inline contexts such as a <label>.
const sizeAttr = size === 'sm' ? undefined : size;
---

<span class:list={["resource-icon", TypeIcon ? typeTint : hue, className]} data-size={sizeAttr}>
  {TypeIcon ? (
    <TypeIcon />
  ) : (
    <>
      <span class="resource-icon-fallback">{initial}</span>
      {hasFavicon && <img src={item.iconUrl} alt="" loading="lazy" data-favicon />}
    </>
  )}
</span>

<script>
  function markLoaded(img: HTMLImageElement) {
    img.classList.add('is-loaded');
  }

  document.querySelectorAll<HTMLImageElement>('img[data-favicon]').forEach((img) => {
    if (img.complete && img.naturalWidth > 0) {
      markLoaded(img);
    } else {
      img.addEventListener('load', () => markLoaded(img), { once: true });
    }
  });
</script>

<style is:global>
  @reference "../../styles/global.css";

  /* Rendered once per resource row, so the tile's utilities live here once.
     Hue classes stay in the markup; "sm" is the default size, "md" is used by
     stack tiles and "lg" by product pages. */
  @layer components {
    .resource-icon {
      @apply relative flex h-9 w-9 flex-shrink-0 items-center justify-center overflow-hidden rounded-lg;
    }

    .resource-icon > svg {
      @apply h-[18px] w-[18px];
    }

    .resource-icon img[data-favicon] {
      @apply absolute inset-0 m-auto h-5 w-5 rounded-sm object-contain;
    }

    .resource-icon-fallback {
      @apply text-sm font-semibold;
    }

    .resource-icon[data-size="md"] {
      @apply h-11 w-11 rounded-[10px];
    }

    .resource-icon[data-size="md"] > svg {
      @apply h-6 w-6;
    }

    .resource-icon[data-size="md"] img[data-favicon] {
      @apply h-6 w-6 rounded;
    }

    .resource-icon[data-size="md"] .resource-icon-fallback {
      @apply text-base;
    }

    .resource-icon[data-size="lg"] {
      @apply h-14 w-14 rounded-xl;
    }

    .resource-icon[data-size="lg"] > svg {
      @apply h-7 w-7;
    }

    .resource-icon[data-size="lg"] img[data-favicon] {
      @apply h-8 w-8 rounded-md;
    }

    .resource-icon[data-size="lg"] .resource-icon-fallback {
      @apply text-xl;
    }
  }

  /* Favicons fade in over the letter fallback only once they have actually
     loaded, so slow or dead icon hosts never leave an empty tile. */
  .resource-icon img[data-favicon] {
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .resource-icon img[data-favicon].is-loaded {
    opacity: 1;
  }

  .resource-icon:has(img[data-favicon].is-loaded) {
    background-color: rgb(0 0 0 / 0.04);
  }

  .resource-icon:has(img[data-favicon].is-loaded) .resource-icon-fallback {
    visibility: hidden;
  }
</style>
