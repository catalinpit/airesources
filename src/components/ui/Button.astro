---
import type { HTMLAttributes } from 'astro/types';

// `inverse` and `ghost` are for dark or gradient surfaces.
type Variant = 'primary' | 'tonal' | 'inverse' | 'ghost';

interface Props extends HTMLAttributes<'button'> {
  /** Renders an anchor. Off-site links open in a new tab; site-relative ones navigate in place. */
  href?: string;
  variant?: Variant;
}

const { href, type = 'button', variant = 'primary', class: className, ...attrs } = Astro.props;

const isExternal = href !== undefined && /^https?:\/\//i.test(href);

const baseClass = 'inline-flex h-9 items-center justify-center rounded-lg px-4 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40 disabled:cursor-not-allowed disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50';

const variantClass: Record<Variant, string> = {
  primary: 'bg-indigo-600 text-white hover:bg-indigo-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-50',
  tonal: 'bg-black/[0.04] text-neutral-700 hover:bg-black/[0.08] hover:text-neutral-900',
  inverse: 'bg-white text-indigo-700 shadow-sm hover:bg-indigo-50 focus-visible:ring-white/60',
  ghost: 'bg-white/15 text-white ring-1 ring-inset ring-white/15 hover:bg-white/25 focus-visible:ring-white/60',
};
---

{
  href ? (
    <a
      href={href}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      class:list={[baseClass, variantClass[variant], className]}
      {...attrs}
    >
      <slot />
      {isExternal && <span class="sr-only">(opens in new tab)</span>}
    </a>
  ) : (
    <button type={type} class:list={[baseClass, variantClass[variant], className]} {...attrs}>
      <slot />
    </button>
  )
}
