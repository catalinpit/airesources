---
import type { HTMLAttributes } from 'astro/types';

// `primary` for the one action a view is about; `outline` for everything else.
type Variant = 'primary' | 'outline';

interface Props extends HTMLAttributes<'button'> {
  /** Renders an anchor. Off-site links open in a new tab; site-relative ones navigate in place. */
  href?: string;
  variant?: Variant;
}

const { href, type = 'button', variant = 'primary', class: className, ...attrs } = Astro.props;

const isExternal = href !== undefined && /^https?:\/\//i.test(href);

const baseClass = 'inline-flex h-9 items-center justify-center rounded-lg px-4 text-sm font-medium transition-[background-color,box-shadow,color,transform] duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40 focus-visible:ring-offset-2 focus-visible:ring-offset-white active:translate-y-px disabled:cursor-not-allowed disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50';

// Both variants stay flat; a 1px shadow is all the depth they get.
const variantClass: Record<Variant, string> = {
  primary: 'bg-indigo-600 text-white shadow-[0_1px_2px_rgba(15,23,42,0.12)] hover:bg-indigo-500',
  outline:
    'bg-white text-neutral-800 inset-ring inset-ring-black/[0.1] shadow-[0_1px_2px_rgba(15,23,42,0.06)] hover:bg-indigo-50/60 hover:text-indigo-700 hover:inset-ring-indigo-200',
};
---

{
  href ? (
    <a
      href={href}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      class:list={[baseClass, variantClass[variant], className]}
      {...attrs}
    >
      <slot />
      {isExternal && <span class="sr-only">(opens in new tab)</span>}
    </a>
  ) : (
    <button type={type} class:list={[baseClass, variantClass[variant], className]} {...attrs}>
      <slot />
    </button>
  )
}
