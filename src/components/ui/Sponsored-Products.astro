---
import ResourceList from './Resource-List.astro';
import SectionLabel from './Section-Label.astro';
import type { ResourceListItem } from './Resource-Row.astro';

interface Props {
	items: ResourceListItem[];
	class?: string;
}

const { items, class: className } = Astro.props;

const sponsoredItems = items.filter((item) => item.sponsored === "big");
---

{sponsoredItems.length > 0 && (
	<section class={className}>
		<SectionLabel label="Featured" tone="amber" class="mb-3" />
		<ResourceList items={sponsoredItems} showCategory />
	</section>
)}
