---
import Button from './Button.astro';
import LogoIcon from '../icons/LogoIcon.astro';
import CategoryDropdown from './CategoryDropdown.astro';
import { REPO_URL } from '../../lib/site';

const { pathname } = Astro.url;
const onStacks = pathname.startsWith('/stack/');
// "page" only on /stack/ itself; child routes mark the link as the current section.
const stacksCurrent = pathname === '/stack/' ? 'page' : onStacks ? 'true' : undefined;
---

<header class="sticky top-0 z-40 border-b border-black/[0.06] bg-white/85 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-4xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="Primary">
    <a href="/" class="flex min-w-0 items-center gap-2 text-neutral-900" aria-label="AI Resources home">
      <LogoIcon class="h-7 w-7 flex-shrink-0" />
      <span class="hidden truncate text-base font-semibold sm:inline">AI Resources</span>
    </a>
    <div class="flex flex-shrink-0 items-center gap-2 sm:gap-3">
      <a
        href="/stack/"
        class:list={[
          "inline-flex h-9 items-center rounded-lg px-2.5 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40 sm:px-3",
          onStacks ? "bg-indigo-50 text-indigo-700" : "text-neutral-700 hover:bg-black/[0.04] hover:text-neutral-900",
        ]}
        aria-current={stacksCurrent}
      >
        Stacks
      </a>
      <CategoryDropdown />
      <Button href={REPO_URL} class="h-9 whitespace-nowrap rounded-lg px-3 text-sm sm:px-4">
        <span class="hidden sm:inline">Submit Tool</span>
        <span class="sm:hidden">Submit</span>
      </Button>
    </div>
  </nav>
</header>
