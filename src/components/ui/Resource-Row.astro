---
import ResourceIcon from './Resource-Icon.astro';
import { PRICING_LABELS } from '../../lib/pricing';
import { FILTER_TYPES, facetsOf } from '../../lib/filters';
import { resourcePath } from '../../lib/resources';
import type { Resource } from '../../lib/resources';

export type ResourceListItem = Resource & {
  categoryTitle?: string;
};

interface Props {
  item: ResourceListItem;
  showCategory?: boolean;
  showAuthor?: boolean;
}

const { item, showCategory = false, showAuthor = true } = Astro.props;

// FilterBar's client script finds rows via the `data-resource` marker and reads
// each facet from a comma-separated `data-<type>` attribute (JSON would need
// `&quot;` escaping in every row). Astro drops attributes whose value is
// undefined, so rows without a facet carry nothing.
const facets = facetsOf(item);
const filterAttrs = {
  'data-resource': '',
  ...Object.fromEntries(FILTER_TYPES.map((type) => [`data-${type}`, facets[type].join(',') || undefined])),
};

const metaText = [
  showCategory ? item.categoryTitle : undefined,
  showAuthor ? item.author?.name : undefined,
  item.pricing ? PRICING_LABELS[item.pricing.type] : undefined,
].filter(Boolean).join(' · ');
---

<a href={resourcePath(item)} class="resource-row" {...filterAttrs}>
  <ResourceIcon item={item} />

  <div class="resource-row-body">
    <div class="resource-row-head">
      <h3 class="resource-row-title">{item.name}</h3>
      {(item.sponsored || metaText) && (
        <span class="resource-row-meta">
          {item.sponsored && <span class="text-amber-600">Sponsored</span>}
          {item.sponsored && metaText && <span aria-hidden="true">·</span>}
          {metaText}
        </span>
      )}
    </div>
    <p class="resource-row-description">{item.description}</p>
  </div>
</a>
