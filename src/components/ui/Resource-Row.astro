---
import type { CollectionEntry } from 'astro:content';
import ResourceIcon from './Resource-Icon.astro';

export type ResourceListItem = CollectionEntry<'resources'>['data'] & {
  categoryTitle?: string;
};

interface Props {
  item: ResourceListItem;
  showCategory?: boolean;
}

const { item, showCategory = false } = Astro.props;

const productSlug = item.name.toLowerCase().replace(/\s+/g, '-');

const resourceData = {
  name: item.name,
  techStack: item.techStack || [],
  features: item.features || [],
  badges: item.badges || {},
  pricing: item.pricing,
  integrations: item.integrations || [],
};

const pricingLabels = {
  free: 'Free',
  paid: 'Paid',
  freemium: 'Freemium',
  byok: 'BYOK',
  'top-up': 'Top-up',
} as const;

const metaText = [
  showCategory ? item.categoryTitle : undefined,
  item.pricing ? pricingLabels[item.pricing.type] : undefined,
].filter(Boolean).join(' · ');
---

<a
  href={`/${item.categorySlug}/${productSlug}/`}
  class="group flex items-center gap-3 px-4 py-3 transition-colors hover:bg-black/[0.02] focus:outline-none focus-visible:bg-black/[0.04] sm:gap-4"
  data-resource={JSON.stringify(resourceData)}
>
  <ResourceIcon item={item} />

  <div class="min-w-0 flex-1">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="truncate text-[15px] font-medium leading-6 text-neutral-900 transition-colors group-hover:text-indigo-600">
        {item.name}
      </h3>
      {(item.sponsored || metaText) && (
        <span class="hidden flex-shrink-0 items-center gap-1.5 text-xs text-neutral-400 sm:flex">
          {item.sponsored && <span class="text-amber-600">Sponsored</span>}
          {item.sponsored && metaText && <span aria-hidden="true">·</span>}
          {metaText}
        </span>
      )}
    </div>
    <p class="mt-0.5 truncate text-sm leading-5 text-neutral-500">
      {item.description}
    </p>
  </div>
</a>
