---
interface Props {
  label: string;
  tone?: 'default' | 'amber';
  class?: string;
}

const { label, tone = 'default', class: className } = Astro.props;
---

<p class:list={[
  "font-mono text-xs font-medium uppercase tracking-[0.18em]",
  tone === 'amber' ? "text-amber-200" : "text-neutral-300",
  className
]}>
  {label}
</p>
