---
interface Props {
  label: string;
  tone?: 'default' | 'amber';
  class?: string;
}

const { label, tone = 'default', class: className } = Astro.props;
---

<p class:list={[
  "font-mono text-[11px] font-medium uppercase tracking-[0.1em]",
  tone === 'amber' ? "text-amber-700" : "text-neutral-500",
  className
]}>
  {label}
</p>
