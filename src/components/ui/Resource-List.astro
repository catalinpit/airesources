---
import ResourceRow from './Resource-Row.astro';
import type { ResourceListItem } from './Resource-Row.astro';

interface Props {
  items: ResourceListItem[];
  showCategory?: boolean;
  class?: string;
}

const { items, showCategory = false, class: className } = Astro.props;
---

<div class:list={[
  "overflow-hidden rounded-xl border border-black/[0.06] bg-white shadow-[0_8px_30px_rgba(0,0,0,0.04)]",
  className
]}>
  <div class="divide-y divide-black/[0.05]">
    {items.map((item) => (
      <ResourceRow item={item} showCategory={showCategory} />
    ))}
  </div>
  <p data-empty-state hidden class="px-4 py-10 text-center text-sm text-neutral-500">
    No resources match your search.
  </p>
</div>
