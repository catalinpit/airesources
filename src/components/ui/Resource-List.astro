---
import ResourceRow from './Resource-Row.astro';
import type { ResourceListItem } from './Resource-Row.astro';

interface Props {
  items: ResourceListItem[];
  showCategory?: boolean;
  class?: string;
}

const { items, showCategory = false, class: className } = Astro.props;
---

<div class:list={[
  "overflow-hidden rounded-lg border border-white/10 bg-[#10131b] shadow-[0_20px_45px_rgba(0,0,0,0.18)]",
  className
]}>
  <div class="divide-y divide-white/[0.06]">
    {items.map((item) => (
      <ResourceRow item={item} showCategory={showCategory} />
    ))}
  </div>
  <p data-empty-state hidden class="px-4 py-10 text-center text-sm text-neutral-400">
    No resources match your search.
  </p>
</div>
