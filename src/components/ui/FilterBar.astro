---
interface Props {
  allResources: Array<{
    name: string;
    techStack?: string[];
    features?: string[];
    badges?: {
      featured?: boolean;
      bestseller?: boolean;
      verified?: boolean;
      new?: boolean;
    };
    pricing?: {
      type: 'free' | 'paid' | 'freemium' | 'byok' | 'top-up';
    };
    integrations?: string[];
    categorySlug: string;
  }>;
  activeFilters: {
    techStack?: string[];
    features?: string[];
    badges?: string[];
    pricing?: string[];
    integrations?: string[];
  };
}

const { allResources, activeFilters } = Astro.props;

const allTechStack = Array.from(new Set(
  allResources.flatMap(r => r.techStack || [])
)).sort();

const allFeatures = Array.from(new Set(
  allResources.flatMap(r => r.features || [])
)).sort();

const allIntegrations = Array.from(new Set(
  allResources.flatMap(r => r.integrations || [])
)).sort();

const badgeOptions = [
  { value: 'featured', label: 'Featured' },
  { value: 'bestseller', label: 'Popular' },
  { value: 'verified', label: 'Verified' },
  { value: 'new', label: 'New' },
];

const pricingOptions = [
  { value: 'free', label: 'Free' },
  { value: 'freemium', label: 'Freemium' },
  { value: 'paid', label: 'Paid' },
  { value: 'byok', label: 'BYOK' },
  { value: 'top-up', label: 'Top-up' },
];

const availableBadges = badgeOptions.filter(option =>
  allResources.some(resource => resource.badges?.[option.value as keyof NonNullable<typeof resource.badges>])
);

const availablePricing = pricingOptions.filter(option =>
  allResources.some(resource => resource.pricing?.type === option.value)
);

const filterGroups = [
  { type: 'pricing', label: 'Pricing', options: availablePricing, active: activeFilters.pricing },
  { type: 'badges', label: 'Badges', options: availableBadges, active: activeFilters.badges },
  { type: 'features', label: 'Features', options: allFeatures.map(value => ({ value, label: value })), active: activeFilters.features },
  { type: 'techStack', label: 'Tech Stack', options: allTechStack.map(value => ({ value, label: value })), active: activeFilters.techStack },
  { type: 'integrations', label: 'Integrations', options: allIntegrations.map(value => ({ value, label: value })), active: activeFilters.integrations },
].filter(group => group.options.length > 0);
---

<div id="filter-bar" class="mb-4">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
    <div class="relative flex-1">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
        <svg class="h-4 w-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="search"
        id="search-input"
        placeholder="Search by name..."
        aria-label="Search resources by name"
        class="h-10 w-full rounded-lg border border-white/10 bg-[#10131b] pl-10 pr-4 text-sm text-white placeholder-neutral-500 transition-colors focus:border-indigo-300/70 focus:outline-none focus:ring-2 focus:ring-indigo-400/15"
      />
    </div>

    {filterGroups.length > 0 && (
      <button
        type="button"
        id="toggle-filters"
        aria-expanded="false"
        aria-controls="filter-panel"
        class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-white/10 bg-[#10131b] px-3.5 text-sm font-medium text-neutral-300 transition-colors hover:border-indigo-300/40 hover:text-white"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M7 12h10M10 18h4" />
        </svg>
        Filters
        <span id="active-filter-count" hidden class="rounded-md bg-white px-1.5 py-0.5 text-xs font-semibold text-neutral-950"></span>
      </button>
    )}
  </div>

  {filterGroups.length > 0 && (
    <div id="filter-panel" hidden class="mt-2 space-y-4 rounded-lg border border-white/10 bg-[#10131b] p-4">
      {filterGroups.map(group => (
        <div>
          <p class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-neutral-400">{group.label}</p>
          <div class="flex flex-wrap gap-2">
            {group.options.map(option => {
              const isActive = group.active?.includes(option.value);
              return (
                <button
                  type="button"
                  data-filter-type={group.type}
                  data-filter-value={option.value}
                  class:list={[
                    "inline-flex h-8 items-center rounded-lg border px-3 text-sm font-medium transition-colors",
                    isActive
                      ? "border-white bg-white text-neutral-950"
                      : "border-white/10 bg-white/[0.04] text-neutral-300 hover:border-indigo-300/40 hover:text-white"
                  ]}
                >
                  {option.label}
                </button>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  )}

  <div class="mt-3 flex items-center justify-between gap-4">
    <div id="results-count" class="text-sm text-neutral-400">
      <span data-resource-count>{allResources.length}</span> resources
    </div>
    <div class="flex min-w-0 flex-1 items-center justify-end gap-2">
      <div id="active-filters" class="flex flex-wrap justify-end gap-2 empty:hidden"></div>
      <button
        id="clear-filters"
        hidden
        class="rounded-lg px-2.5 py-1 text-sm font-medium text-neutral-400 transition-colors hover:bg-white/10 hover:text-white"
      >
        Clear all
      </button>
    </div>
  </div>
</div>

<script>
  const filterBar = document.getElementById('filter-bar');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const clearFiltersBtn = document.getElementById('clear-filters');
  const activeFiltersContainer = document.getElementById('active-filters');
  const activeFilterCount = document.getElementById('active-filter-count');
  const resultsCount = document.getElementById('results-count');
  const toggleFiltersBtn = document.getElementById('toggle-filters');
  const filterPanel = document.getElementById('filter-panel');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

  const resourceRows = Array.from(document.querySelectorAll<HTMLElement>('[data-resource]'));

  const urlParams = new URLSearchParams(window.location.search);
  const filters = {
    techStack: urlParams.get('techStack')?.split(',').filter(Boolean) || [],
    features: urlParams.get('features')?.split(',').filter(Boolean) || [],
    badges: urlParams.get('badges')?.split(',').filter(Boolean) || [],
    pricing: urlParams.get('pricing')?.split(',').filter(Boolean) || [],
    integrations: urlParams.get('integrations')?.split(',').filter(Boolean) || [],
    search: urlParams.get('search') || '',
  };

  type FilterType = 'techStack' | 'features' | 'badges' | 'pricing' | 'integrations';
  const filterTypes: FilterType[] = ['techStack', 'features', 'badges', 'pricing', 'integrations'];

  function setPanelOpen(open: boolean) {
    if (!filterPanel || !toggleFiltersBtn) return;
    filterPanel.hidden = !open;
    toggleFiltersBtn.setAttribute('aria-expanded', String(open));
  }

  function updateURL() {
    const params = new URLSearchParams();
    filterTypes.forEach(type => {
      if (filters[type].length) params.set(type, filters[type].join(','));
    });
    if (filters.search) params.set('search', filters.search);

    const newURL = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
    window.history.replaceState({}, '', newURL);
  }

  function renderActiveFilters() {
    if (!activeFiltersContainer) return;
    activeFiltersContainer.innerHTML = '';

    const allActive = [
      ...filters.techStack.map(t => ({ type: 'techStack', label: t, value: t })),
      ...filters.features.map(f => ({ type: 'features', label: f, value: f })),
      ...filters.badges.map(b => ({ type: 'badges', label: b.charAt(0).toUpperCase() + b.slice(1), value: b })),
      ...filters.pricing.map(p => ({ type: 'pricing', label: p.charAt(0).toUpperCase() + p.slice(1), value: p })),
      ...filters.integrations.map(i => ({ type: 'integrations', label: i, value: i })),
    ];

    const hasFilters = allActive.length > 0 || Boolean(filters.search);

    if (clearFiltersBtn) clearFiltersBtn.hidden = !hasFilters;
    if (activeFilterCount) {
      activeFilterCount.hidden = allActive.length === 0;
      activeFilterCount.textContent = String(allActive.length);
    }

    allActive.forEach(filter => {
      const chip = document.createElement('span');
      chip.className = 'inline-flex items-center gap-1.5 rounded-md border border-indigo-300/25 bg-indigo-400/10 px-2 py-0.5 text-xs font-medium text-indigo-100';
      chip.innerHTML = `
        ${filter.label}
        <button
          type="button"
          onclick="removeFilter('${filter.type}', '${filter.value}')"
          class="rounded p-0.5 transition-colors hover:bg-white/15"
          aria-label="Remove filter ${filter.label}"
        >
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      `;
      activeFiltersContainer.appendChild(chip);
    });
  }

  function filterResources() {
    let visibleCount = 0;

    resourceRows.forEach(row => {
      const resourceData = JSON.parse(row.getAttribute('data-resource') || '{}');
      let visible = true;

      if (filters.search) {
        visible = resourceData.name?.toLowerCase().includes(filters.search.trim().toLowerCase()) ?? false;
      }

      if (filters.techStack.length && visible) {
        visible = filters.techStack.some(tech => resourceData.techStack?.includes(tech));
      }

      if (filters.features.length && visible) {
        visible = filters.features.some(feature => resourceData.features?.includes(feature));
      }

      if (filters.badges.length && visible) {
        visible = filters.badges.some(badge => resourceData.badges?.[badge] === true);
      }

      if (filters.pricing.length && visible) {
        visible = filters.pricing.includes(resourceData.pricing?.type);
      }

      if (filters.integrations.length && visible) {
        visible = filters.integrations.some(integration => resourceData.integrations?.includes(integration));
      }

      row.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    if (emptyState) emptyState.hidden = visibleCount > 0;

    if (resultsCount) {
      const total = resourceRows.length;
      resultsCount.innerHTML = visibleCount === total
        ? `<span data-resource-count>${total}</span> resources`
        : `<span data-resource-count>${visibleCount}</span> of ${total} resources`;
    }
  }

  function updateFilterButtons() {
    filterBar?.querySelectorAll('[data-filter-type]').forEach(btn => {
      const type = btn.getAttribute('data-filter-type') as FilterType | null;
      const value = btn.getAttribute('data-filter-value');
      const isActive = type ? filters[type].includes(value || '') : false;

      btn.classList.toggle('border-white', isActive);
      btn.classList.toggle('bg-white', isActive);
      btn.classList.toggle('text-neutral-950', isActive);
      btn.classList.toggle('border-white/10', !isActive);
      btn.classList.toggle('bg-white/[0.04]', !isActive);
      btn.classList.toggle('text-neutral-300', !isActive);
    });
  }

  function applyFilters() {
    updateURL();
    updateFilterButtons();
    renderActiveFilters();
    filterResources();
  }

  (window as any).removeFilter = function(type: string, value: string) {
    if (type === 'search') {
      filters.search = '';
      if (searchInput) searchInput.value = '';
    } else {
      const filterArray = filters[type as FilterType];
      const index = filterArray.indexOf(value);
      if (index > -1) filterArray.splice(index, 1);
    }
    applyFilters();
  };

  toggleFiltersBtn?.addEventListener('click', () => {
    setPanelOpen(filterPanel?.hidden ?? false);
  });

  if (searchInput) {
    searchInput.value = filters.search;
    let searchTimeout: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        filters.search = (e.target as HTMLInputElement).value;
        applyFilters();
      }, 200);
    });
  }

  filterBar?.querySelectorAll('[data-filter-type]').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-filter-type') as FilterType | null;
      const value = btn.getAttribute('data-filter-value');
      if (!type || !value) return;

      const filterArray = filters[type];
      const index = filterArray.indexOf(value);

      if (index > -1) {
        filterArray.splice(index, 1);
      } else {
        filterArray.push(value);
      }

      applyFilters();
    });
  });

  clearFiltersBtn?.addEventListener('click', () => {
    filterTypes.forEach(type => { filters[type] = []; });
    filters.search = '';
    if (searchInput) searchInput.value = '';
    applyFilters();
  });

  if (filterTypes.some(type => filters[type].length > 0)) {
    setPanelOpen(true);
  }

  updateFilterButtons();
  renderActiveFilters();
  filterResources();
</script>
