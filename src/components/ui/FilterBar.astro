---
import SearchInput from './Search-Input.astro';
import { FACETS, FILTER_TYPES, facetsOf } from '../../lib/filters';
import type { Resource } from '../../lib/resources';

interface Props {
  allResources: Array<Pick<Resource, 'pricing' | 'features'>>;
  title?: string;
  showSearch?: boolean;
}

const { allResources, title, showSearch = true } = Astro.props;

// Active state is applied on the client from the URL, so chips render idle.
const filterGroups = FILTER_TYPES.map((type) => ({
  type,
  label: FACETS[type].label,
  options: FACETS[type].options(new Set(allResources.flatMap((resource) => facetsOf(resource)[type]))),
})).filter((group) => group.options.length > 0);

const chipClass = "inline-flex h-8 items-center rounded-lg bg-black/[0.04] px-3 text-sm font-medium text-neutral-700 transition-colors hover:bg-black/[0.08] hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40";
---

<div id="filter-bar" class="mb-3">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    {showSearch ? (
      <SearchInput class="flex-1" />
    ) : (
      <div class="flex items-baseline gap-2.5">
        {title && <h2 class="text-base font-semibold text-neutral-900">{title}</h2>}
        <span id="results-count" class="text-sm text-neutral-500">
          <span data-resource-count>{allResources.length}</span> resources
        </span>
      </div>
    )}

    <div class="flex items-center justify-between gap-3 sm:justify-end">
      {showSearch && (
        <span id="results-count" class="text-sm text-neutral-500">
          <span data-resource-count>{allResources.length}</span> resources
        </span>
      )}
      {filterGroups.length > 0 && (
        <button
          type="button"
          id="toggle-filters"
          aria-expanded="false"
          aria-controls="filter-panel"
          class="inline-flex h-10 items-center gap-2 rounded-lg bg-black/[0.04] px-3.5 text-sm font-medium text-neutral-700 transition-colors hover:bg-black/[0.08] hover:text-neutral-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M7 12h10M10 18h4" />
          </svg>
          Filters
          <span id="active-filter-count" hidden class="rounded-md bg-indigo-600 px-1.5 py-0.5 text-xs font-semibold text-white"></span>
        </button>
      )}
    </div>
  </div>

  {filterGroups.length > 0 && (
    <div id="filter-panel" hidden class="mt-3 space-y-4 rounded-xl bg-white p-4 ring-1 ring-inset ring-black/[0.06]">
      {filterGroups.map(group => (
        <div>
          <p class="mb-2 font-mono text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">{group.label}</p>
          <div class="flex flex-wrap gap-2">
            {group.options.map(option => (
              <button
                type="button"
                data-filter-type={group.type}
                data-filter-value={option.value}
                class={chipClass}
              >
                {option.label}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}

  <div id="active-filters-row" hidden class="mt-3 flex flex-wrap items-center gap-2">
    <div id="active-filters" class="flex flex-wrap gap-2"></div>
    <button
      type="button"
      id="clear-filters"
      class="rounded-md px-2 py-1 text-xs font-medium text-neutral-500 transition-colors hover:bg-black/[0.05] hover:text-neutral-900"
    >
      Clear all
    </button>
  </div>
</div>

<script>
  import { FILTER_TYPES, type FilterType } from '../../lib/filters';

  const filterBar = document.getElementById('filter-bar');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const clearFiltersBtn = document.getElementById('clear-filters');
  const activeFiltersRow = document.getElementById('active-filters-row');
  const activeFiltersContainer = document.getElementById('active-filters');
  const activeFilterCount = document.getElementById('active-filter-count');
  const resultsCount = document.getElementById('results-count');
  const toggleFiltersBtn = document.getElementById('toggle-filters');
  const filterPanel = document.getElementById('filter-panel');

  // Only the list this bar sits next to; pages also render a sponsored
  // ResourceList above it that must not be filtered or counted.
  const scope = filterBar?.parentElement ?? document;
  const emptyState = scope.querySelector<HTMLElement>('[data-empty-state]');

  const facetsFrom = (read: (type: FilterType) => string[]) =>
    Object.fromEntries(FILTER_TYPES.map(type => [type, read(type)])) as Record<FilterType, string[]>;

  const resourceRows = Array.from(scope.querySelectorAll<HTMLElement>('[data-resource]')).map(row => ({
    el: row,
    name: row.querySelector('h3')?.textContent?.trim().toLowerCase() ?? '',
    facets: facetsFrom(type => row.dataset[type]?.split(',') ?? []),
  }));

  const isFilterType = (value: string | null): value is FilterType => FILTER_TYPES.includes(value as FilterType);

  interface FilterChip {
    el: HTMLElement;
    type: FilterType;
    value: string;
    label: string;
  }

  // Valid filter values and their labels come from the rendered buttons
  const chips: FilterChip[] = Array.from(filterBar?.querySelectorAll<HTMLElement>('[data-filter-type]') ?? []).flatMap(el => {
    const type = el.getAttribute('data-filter-type');
    const value = el.getAttribute('data-filter-value');
    return isFilterType(type) && value ? [{ el, type, value, label: el.textContent?.trim() || value }] : [];
  });
  const chipFor = (type: FilterType, value: string) => chips.find(chip => chip.type === type && chip.value === value);

  const urlParams = new URLSearchParams(window.location.search);
  function readFilterParam(type: FilterType): string[] {
    const values = urlParams.get(type)?.split(',') ?? [];
    return [...new Set(values.filter(value => chipFor(type, value)))];
  }

  const filters: Record<FilterType, string[]> & { search: string } = {
    ...facetsFrom(readFilterParam),
    search: urlParams.get('search') || '',
  };

  const activeChipClasses = ['bg-indigo-600', 'text-white', 'hover:bg-indigo-500'];
  const idleChipClasses = ['bg-black/[0.04]', 'text-neutral-700', 'hover:bg-black/[0.08]', 'hover:text-neutral-900'];

  function setPanelOpen(open: boolean) {
    if (!filterPanel || !toggleFiltersBtn) return;
    filterPanel.hidden = !open;
    toggleFiltersBtn.setAttribute('aria-expanded', String(open));
  }

  function updateURL() {
    const params = new URLSearchParams();
    FILTER_TYPES.forEach(type => {
      if (filters[type].length) params.set(type, filters[type].join(','));
    });
    if (filters.search) params.set('search', filters.search);

    const newURL = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
    window.history.replaceState({}, '', newURL);
  }

  const REMOVE_ICON_SVG = '<svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>';

  function toggleFilter(type: FilterType, value: string) {
    const active = filters[type];
    const index = active.indexOf(value);
    if (index > -1) {
      active.splice(index, 1);
    } else {
      active.push(value);
    }
    applyFilters();
  }

  function renderActiveFilters() {
    if (!activeFiltersContainer) return;
    activeFiltersContainer.replaceChildren();

    const allActive = FILTER_TYPES.flatMap(type =>
      filters[type].map(value => ({ type, value, label: chipFor(type, value)?.label ?? value }))
    );

    if (activeFiltersRow) activeFiltersRow.hidden = allActive.length === 0;
    if (activeFilterCount) {
      activeFilterCount.hidden = allActive.length === 0;
      activeFilterCount.textContent = String(allActive.length);
    }

    allActive.forEach(filter => {
      const chip = document.createElement('span');
      chip.className = 'inline-flex items-center gap-1.5 rounded-md bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700';
      chip.append(filter.label);

      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className = 'rounded p-0.5 transition-colors hover:bg-indigo-100';
      removeButton.setAttribute('aria-label', `Remove filter ${filter.label}`);
      removeButton.innerHTML = REMOVE_ICON_SVG;
      removeButton.addEventListener('click', () => toggleFilter(filter.type, filter.value));

      chip.appendChild(removeButton);
      activeFiltersContainer.appendChild(chip);
    });
  }

  function filterResources() {
    let visibleCount = 0;
    const searchTerm = filters.search.trim().toLowerCase();

    resourceRows.forEach(row => {
      // Within a facet any selected value matches; across facets all must match.
      const visible =
        (!searchTerm || row.name.includes(searchTerm)) &&
        FILTER_TYPES.every(type => !filters[type].length || filters[type].some(value => row.facets[type].includes(value)));

      row.el.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    if (emptyState) emptyState.hidden = visibleCount > 0;

    if (resultsCount) {
      const total = resourceRows.length;
      resultsCount.innerHTML = visibleCount === total
        ? `<span data-resource-count>${total}</span> resources`
        : `<span data-resource-count>${visibleCount}</span> of ${total} resources`;
    }
  }

  function updateFilterButtons() {
    chips.forEach(({ el, type, value }) => {
      const isActive = filters[type].includes(value);
      activeChipClasses.forEach(cls => el.classList.toggle(cls, isActive));
      idleChipClasses.forEach(cls => el.classList.toggle(cls, !isActive));
    });
  }

  function applyFilters() {
    updateURL();
    updateFilterButtons();
    renderActiveFilters();
    filterResources();
  }

  toggleFiltersBtn?.addEventListener('click', () => {
    setPanelOpen(Boolean(filterPanel?.hidden));
  });

  if (searchInput) {
    searchInput.value = filters.search;
    let searchTimeout: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        filters.search = (e.target as HTMLInputElement).value;
        applyFilters();
      }, 200);
    });
  }

  chips.forEach(({ el, type, value }) => {
    el.addEventListener('click', () => toggleFilter(type, value));
  });

  clearFiltersBtn?.addEventListener('click', () => {
    FILTER_TYPES.forEach(type => { filters[type] = []; });
    filters.search = '';
    if (searchInput) searchInput.value = '';
    applyFilters();
  });

  if (FILTER_TYPES.some(type => filters[type].length > 0)) {
    setPanelOpen(true);
  }

  updateFilterButtons();
  renderActiveFilters();
  filterResources();
</script>
