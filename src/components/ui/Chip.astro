---
import type { HTMLAttributes } from 'astro/types';

/**
 * A small selectable pill: category links, filter toggles, tags. The active
 * look is keyed off a `data-active` attribute so client scripts can flip it
 * (`el.toggleAttribute('data-active', on)`) without knowing any class names.
 */
interface Props extends HTMLAttributes<'button'> {
  href?: string;
  active?: boolean;
}

const { href, active = false, class: className, ...attrs } = Astro.props;

const chipClass =
  'inline-flex h-8 items-center gap-1.5 rounded-lg bg-white px-3 text-sm font-medium text-neutral-700 inset-ring inset-ring-black/[0.08] shadow-[0_1px_2px_rgba(15,23,42,0.05)] transition-[background-color,box-shadow,color] duration-150 hover:bg-indigo-50/60 hover:text-indigo-700 hover:inset-ring-indigo-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40 data-active:bg-indigo-600 data-active:text-white data-active:inset-ring-indigo-600 data-active:shadow-[0_6px_16px_-8px_rgba(79,70,229,0.9)] data-active:hover:bg-indigo-500 data-active:hover:text-white';
---

{
  href ? (
    <a href={href} class:list={[chipClass, className]} data-active={active || undefined} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={[chipClass, className]} data-active={active || undefined} {...attrs}>
      <slot />
    </button>
  )
}
