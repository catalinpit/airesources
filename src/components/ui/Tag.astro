---
interface Props {
  href: string;
  isActive?: boolean;
  class?: string;
}

const { href, isActive = false, class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex h-8 items-center rounded-lg px-3 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500/40',
    isActive
      ? 'bg-indigo-600 text-white hover:bg-indigo-500'
      : 'bg-black/[0.04] text-neutral-700 hover:bg-black/[0.08] hover:text-neutral-900',
    className
  ]}
>
  <slot />
</a>
